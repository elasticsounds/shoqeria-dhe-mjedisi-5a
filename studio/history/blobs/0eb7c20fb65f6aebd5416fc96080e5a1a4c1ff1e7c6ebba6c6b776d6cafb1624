/* Book-scoped persistence only. The original runtime remains responsible for grading. */
(function () {
  if (window.__adt5aResponses) return;
  window.__adt5aResponses = true;
  var prefix = 'adt5a.responses.f7bf719411a7c7cf.';
  var restored = new WeakMap();
  var restoring = false;
  var pending = false;
  function current() {
    var root = document.querySelector('#content.book');
    var meta = document.querySelector('meta[name="title-id"]');
    if (!root || !meta) return null;
    var section = root.querySelector('[data-section-id],[data-correct-answers]');
    var id = section && (section.getAttribute('data-section-id') || section.getAttribute('data-id'));
    if (id !== meta.content) return null;
    return {root: root, id: id};
  }
  function controls(root) { return Array.from(root.querySelectorAll('input:not([type=hidden]),textarea,select')); }
  function key(el, index) { return el.id || el.getAttribute('data-activity-item') || el.name + ':' + index; }
  function diary(page) { return page && (page.id === 'pg009_sec001' || page.id === 'pg009_sec002'); }
  function diaryLegacy(id, control) {
    try {
      var values = JSON.parse(localStorage.getItem(prefix + id) || '{}');
      var entry = values[control];
      return entry && typeof entry.value === 'string' ? entry.value : '';
    } catch (_) { return ''; }
  }
  function restoreDiary(page) {
    var field = page.root.querySelector('textarea[data-activity-item="item-1"]');
    if (!field) return;
    var first = diaryLegacy('pg009_sec001', 'item-1');
    var second = diaryLegacy('pg009_sec002', 'activity-item-1');
    var shared = null;
    try { shared = localStorage.getItem(prefix + 'pg009_diary_shared'); } catch (_) {}
    field.value = shared !== null ? shared : (page.id === 'pg009_sec001' ? first || second : second || first);
    if (first && second && first !== second && !page.root.querySelector('.diary-recovery')) {
      var details = document.createElement('details');
      details.className = 'diary-recovery';
      var summary = document.createElement('summary');
      summary.textContent = 'Përgjigjet e ruajtura më parë';
      details.appendChild(summary);
      [first, second].forEach(function (value, i) {
        var label = document.createElement('p');
        label.textContent = 'Versioni ' + (i + 1) + ': ' + value;
        var button = document.createElement('button');
        button.type = 'button';
        button.textContent = 'Përdor versionin ' + (i + 1);
        button.addEventListener('click', function () { field.value = value; field.dispatchEvent(new Event('input', {bubbles:true})); field.focus(); });
        details.appendChild(label); details.appendChild(button);
      });
      page.root.appendChild(details);
    }
  }
  function save() {
    if (restoring) return;
    var page = current();
    if (!page) return;
    if (diary(page)) {
      var field = page.root.querySelector('textarea[data-activity-item="item-1"]');
      if (field) try { localStorage.setItem(prefix + 'pg009_diary_shared', field.value); } catch (_) {}
      return;
    }
    var values = {};
    controls(page.root).forEach(function (el, index) {
      if (['password', 'file'].includes(el.type)) return;
      var quizLabel = el.closest('label[role=radio]');
      values[key(el, index)] = el.type === 'radio' || el.type === 'checkbox' ? {checked: quizLabel ? quizLabel.getAttribute('aria-checked') === 'true' : el.checked} : {value: el.value};
    });
    try { localStorage.setItem(prefix + page.id, JSON.stringify(values)); } catch (_) {}
  }
  function restore() {
    pending = false;
    var page = current();
    if (!page || getComputedStyle(page.root).opacity !== '1') return;
    var quiz = page.root.querySelector('[data-correct-answers]');
    if (quiz && !quiz.querySelector('label[role=radio]')) return;
    if (restored.get(page.root) === page.id) return;
    var values;
    try { values = JSON.parse(localStorage.getItem(prefix + page.id) || '{}'); } catch (_) { values = {}; }
    restored.set(page.root, page.id);
    restoring = true;
    var selectedQuizLabel;
    controls(page.root).forEach(function (el, index) {
      var entry = values[key(el, index)];
      if (!entry) return;
      if ('checked' in entry) {
        if (quiz && entry.checked) selectedQuizLabel = el.closest('label[role=radio]');
        else el.checked = entry.checked;
      } else if (typeof entry.value === 'string') el.value = entry.value;
    });
    if (diary(page)) restoreDiary(page);
    // Reuse the runtime's selection handler so its original feedback and answer keys are respected.
    if (selectedQuizLabel) selectedQuizLabel.click();
