<script>
(function(){
  var storageKey='adt5a.wordsearch.pg028_sec002.cells';
  function read(){try{var x=JSON.parse(localStorage.getItem(storageKey)||'[]');return Array.isArray(x)?x:[]}catch(e){return []}}
  function save(root){var ids=Array.from(root.querySelectorAll('.ws-cell[aria-pressed="true"]')).map(function(b){return b.parentElement.dataset.id});try{localStorage.setItem(storageKey,JSON.stringify(ids))}catch(e){}}
  function init(){
    var root=document.querySelector('[data-section-id="pg028_sec002"]');
    if(!root||root.dataset.wsReady)return;
    var table=root.querySelector('table');if(!table)return;
    root.dataset.wsReady='1';var selected=read();
    Array.from(table.rows).forEach(function(row,r){Array.from(row.cells).forEach(function(cell,c){
      var letter=cell.textContent.trim(), b=document.createElement('button');
      b.type='button';b.className='ws-cell';b.textContent=letter;
      b.setAttribute('aria-label','Rreshti '+(r+1)+', kolona '+(c+1)+': '+letter);
      b.setAttribute('aria-pressed',selected.indexOf(cell.dataset.id)>=0?'true':'false');
      cell.textContent='';cell.appendChild(b);
    })});
    table.addEventListener('click',function(e){var b=e.target.closest('.ws-cell');if(!b)return;b.setAttribute('aria-pressed',b.getAttribute('aria-pressed')==='true'?'false':'true');save(root)});
    var reset=root.querySelector('#ws-reset');if(reset)reset.addEventListener('click',function(){root.querySelectorAll('.ws-cell').forEach(function(b){b.setAttribute('aria-pressed','false')});save(root)});
  }
  init();new MutationObserver(init).observe(document.documentElement,{childList:true,subtree:true});
})();
</script></body></html>