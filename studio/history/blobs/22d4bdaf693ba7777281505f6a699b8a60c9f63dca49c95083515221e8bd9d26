<script>
(function(){
var prefix='adt5a.responses.f7bf719411a7c7cf.', dkey='adt5a.pg021.drawing.', map=[['past','pg021_sec002','item-1'],['present','pg021_sec002','item-2'],['future','pg021_sec003','item-1']];
function get(k){try{return JSON.parse(localStorage.getItem(prefix+k)||'{}')}catch(e){return {}}}
function init(){var root=document.querySelector('#content.pg21');if(!root||root.dataset.pg21Ready)return;root.dataset.pg21Ready='1';
map.forEach(function(m){var el=root.querySelector('#'+m[0]), saved=get(m[1])[m[2]];if(saved&&typeof saved.value==='string')el.value=saved.value;el.addEventListener('input',function(){var v=get(m[1]);v[m[2]]={value:el.value};try{localStorage.setItem(prefix+m[1],JSON.stringify(v))}catch(e){}})});
var dialog=root.querySelector('dialog'),canvas=dialog.querySelector('canvas'),ctx=canvas.getContext('2d'),current='',painting=false;ctx.lineCap='round';ctx.lineJoin='round';ctx.lineWidth=3;ctx.strokeStyle='#30313a';
function preview(k){var v;try{v=localStorage.getItem(dkey+k)}catch(e){}var cell=root.querySelector('[data-drawing="'+k+'"]');if(cell)cell.style.backgroundImage=v?'url("'+v+'")':''}
function store(){try{localStorage.setItem(dkey+current,canvas.toDataURL('image/png'));preview(current)}catch(e){alert('Vizatimi nuk u ruajt. Kontrollo hapësirën e ruajtjes.')}}
root.querySelectorAll('[data-draw]').forEach(function(b){preview(b.dataset.draw);b.addEventListener('click',function(){current=b.dataset.draw;dialog.querySelector('h2').textContent=current==='item-1'?'Vizato: rrugët dikur':'Vizato: rrugët sot';ctx.clearRect(0,0,canvas.width,canvas.height);var url;try{url=localStorage.getItem(dkey+current)}catch(e){}if(url){var img=new Image();img.onload=function(){ctx.drawImage(img,0,0,canvas.width,canvas.height)};img.src=url}dialog.showModal()})});
function point(e){var r=canvas.getBoundingClientRect();return [(e.clientX-r.left)*canvas.width/r.width,(e.clientY-r.top)*canvas.height/r.height]}
canvas.addEventListener('pointerdown',function(e){painting=true;canvas.setPointerCapture(e.pointerId);var p=point(e);ctx.beginPath();ctx.moveTo(p[0],p[1]);ctx.lineTo(p[0]+.01,p[1]+.01);ctx.stroke()});canvas.addEventListener('pointermove',function(e){if(!painting)return;var p=point(e);ctx.lineTo(p[0],p[1]);ctx.stroke()});canvas.addEventListener('pointerup',function(){if(painting){painting=false;store()}});canvas.addEventListener('pointercancel',function(){if(painting){painting=false;store()}});
dialog.querySelector('[data-clear]').addEventListener('click',function(){ctx.clearRect(0,0,canvas.width,canvas.height);try{localStorage.removeItem(dkey+current)}catch(e){}preview(current)});dialog.querySelector('[data-close]').addEventListener('click',function(){dialog.close()});dialog.querySelector('[data-upload]').addEventListener('change',function(e){var f=e.target.files[0];if(!f)return;var img=new Image(),url=URL.createObjectURL(f);img.onload=function(){ctx.clearRect(0,0,canvas.width,canvas.height);var s=Math.min(canvas.width/img.width,canvas.height/img.height);ctx.drawImage(img,(canvas.width-img.width*s)/2,(canvas.height-img.height*s)/2,img.width*s,img.height*s);URL.revokeObjectURL(url);store()};img.src=url;e.target.value=''})}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();new MutationObserver(init).observe(document.documentElement,{childList:true,subtree:true});
})();
