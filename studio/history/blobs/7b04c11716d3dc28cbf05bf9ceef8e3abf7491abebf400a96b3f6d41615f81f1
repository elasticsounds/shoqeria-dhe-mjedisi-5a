          <span class="adt-body font-bold text-white b-keyword-label" data-id="pg041_n0004">Fjalët kyçe:</span>
        </div>
        <p class="adt-body leading-8 text-left text-slate-700">
          <span data-id="pg041_n0005">familje, shoqëri, barazi, vendimmarrje.</span>
