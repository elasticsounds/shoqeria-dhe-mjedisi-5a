<script>
(function(){
 const key='adt5a.drawing.pg014_sec001'; let active=null;
 function init(){const root=document.querySelector('#content.page14'); if(!root || root.dataset.drawingReady) return; const canvas=root.querySelector('[data-draw-canvas]'); if(!canvas)return; root.dataset.drawingReady='1'; const ctx=canvas.getContext('2d'); ctx.strokeStyle='#292a33';ctx.lineWidth=3;ctx.lineCap='round';ctx.lineJoin='round';
  try{const saved=localStorage.getItem(key);if(saved){const image=new Image();image.onload=()=>ctx.drawImage(image,0,0,canvas.width,canvas.height);image.src=saved;}}catch(e){root.querySelector('[data-draw-status]').textContent='Vizatimi nuk mund të rikthehet në këtë shfletues.';}
  function point(e){const r=canvas.getBoundingClientRect();return [(e.clientX-r.left)*canvas.width/r.width,(e.clientY-r.top)*canvas.height/r.height]}
  function save(){try{localStorage.setItem(key,canvas.toDataURL('image/png'));root.querySelector('[data-draw-status]').textContent='Vizatimi u ruajt në këtë pajisje.';}catch(e){root.querySelector('[data-draw-status]').textContent='Vizatimi nuk mund të ruhet në këtë pajisje.';}}
  canvas.addEventListener('pointerdown',e=>{e.preventDefault();active=e.pointerId;canvas.setPointerCapture(e.pointerId);const p=point(e);ctx.beginPath();ctx.moveTo(p[0],p[1]);ctx.lineTo(p[0]+0.01,p[1]+0.01);ctx.stroke();});
  canvas.addEventListener('pointermove',e=>{if(active!==e.pointerId)return;const p=point(e);ctx.lineTo(p[0],p[1]);ctx.stroke();});
  function end(e){if(active===e.pointerId){active=null;save();}}canvas.addEventListener('pointerup',end);canvas.addEventListener('pointercancel',end);
  root.querySelectorAll('[data-draw-mode]').forEach(button=>button.addEventListener('click',()=>{const writing=button.dataset.drawMode==='write';canvas.hidden=writing;root.querySelector('#item-5').hidden=!writing;root.querySelectorAll('[data-draw-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));if(writing)root.querySelector('#item-5').focus();}));
  root.querySelector('[data-draw-clear]').addEventListener('click',()=>{if(confirm('Të pastrohet vizatimi?')){ctx.clearRect(0,0,canvas.width,canvas.height);save();}});
  const file=root.querySelector('[data-draw-file]');root.querySelector('[data-draw-upload]').addEventListener('click',()=>file.click());file.addEventListener('change',()=>{const f=file.files[0];if(!f)return;if(!/^image\/(png|jpeg)$/.test(f.type)){root.querySelector('[data-draw-status]').textContent='Zgjidh një figurë PNG ose JPEG.';return;}const url=URL.createObjectURL(f);const image=new Image();image.onload=()=>{ctx.clearRect(0,0,canvas.width,canvas.height);const scale=Math.min(canvas.width/image.width,canvas.height/image.height);ctx.drawImage(image,0,0,image.width*scale,image.height*scale);URL.revokeObjectURL(url);root.querySelector('[data-draw-mode="draw"]').click();save();};image.onerror=()=>{URL.revokeObjectURL(url);root.querySelector('[data-draw-status]').textContent='Figura nuk mund të hapet.';};image.src=url;file.value='';});
 }
 new MutationObserver(init).observe(document.documentElement,{childList:true,subtree:true});init();
})();
