        if (!window.confirm('Të fshihet vizatimi?')) return;
        ctx.clearRect(0,0,canvas.width,canvas.height); file.value = '';
        try { localStorage.removeItem(storageKey); tell('Vizatimi u fshi.'); } catch (_) { tell('Vizatimi nuk u fshi nga ruajtja.'); }
      });
      file.addEventListener('change', function () {
        var f = file.files && file.files[0]; if (!f) return;
        if (!/^image\/(png|jpeg)$/.test(f.type) || f.size > 10 * 1024 * 1024) { tell('Zgjidh një figurë PNG ose JPG deri në 10 MB.'); file.value = ''; return; }
        var reader = new FileReader(); reader.onload = function () { loadImage(reader.result, true); }; reader.onerror = function () { tell('Figura nuk mund të lexohet.'); }; reader.readAsDataURL(f);
      });
    });
  }
