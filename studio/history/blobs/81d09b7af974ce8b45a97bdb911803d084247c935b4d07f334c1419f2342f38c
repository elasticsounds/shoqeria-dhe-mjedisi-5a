        image.onerror = function () { tell('Figura nuk mund të hapet.'); };
        image.src = url;
      }
      try { var saved = localStorage.getItem(storageKey); if (saved) loadImage(saved, false); } catch (_) { tell('Vizatimi i ruajtur nuk mund të hapet.'); }
      function point(event) { var r = canvas.getBoundingClientRect(); return {x:(event.clientX-r.left)*canvas.width/r.width, y:(event.clientY-r.top)*canvas.height/r.height}; }
      canvas.addEventListener('pointerdown', function (event) {
        if (event.button !== 0 && event.pointerType !== 'touch') return;
        drawing = true; canvas.setPointerCapture(event.pointerId); var p = point(event);
        ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(p.x+0.01,p.y+0.01); ctx.stroke(); event.preventDefault();
      });
      canvas.addEventListener('pointermove', function (event) { if (!drawing) return; var p = point(event); ctx.lineTo(p.x,p.y); ctx.stroke(); event.preventDefault(); });
      function stop() { if (!drawing) return; drawing = false; ctx.closePath(); saveDrawing(); }
      canvas.addEventListener('pointerup', stop); canvas.addEventListener('pointercancel', stop);
