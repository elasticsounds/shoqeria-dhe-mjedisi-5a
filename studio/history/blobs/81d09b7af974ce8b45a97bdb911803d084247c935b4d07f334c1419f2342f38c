        try { localStorage.setItem(storageKey, canvas.toDataURL('image/png')); tell('Vizatimi u ruajt në këtë pajisje.'); }
        catch (_) { tell('Vizatimi nuk u ruajt. Kontrollo hapësirën e ruajtjes në pajisje.'); }
      }
      function loadImage(url, persist) {
        var image = new Image();
        image.onload = function () {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
