  <script>
    (function(){
      var canvas=document.getElementById('drawing-canvas');if(!canvas)return;
      var ctx=canvas.getContext('2d'),strokes=[],active=null,scale=1;
      var storageKey='adt5a.drawing.pg014_sec001.v1';
      try{strokes=JSON.parse(localStorage.getItem(storageKey)||'[]');if(!Array.isArray(strokes))strokes=[];}catch(e){strokes=[];}
      function size(){var r=canvas.getBoundingClientRect();if(!r.width||!r.height)return;scale=window.devicePixelRatio||1;canvas.width=Math.round(r.width*scale);canvas.height=Math.round(r.height*scale);ctx.setTransform(scale,0,0,scale,0,0);paint();}
      function paint(){var r=canvas.getBoundingClientRect();ctx.clearRect(0,0,r.width,r.height);ctx.lineCap='round';ctx.lineJoin='round';strokes.forEach(function(s){if(!s.points||!s.points.length)return;ctx.strokeStyle=s.color||'#30313a';ctx.lineWidth=s.width||2.5;ctx.beginPath();ctx.moveTo(s.points[0][0]*r.width,s.points[0][1]*r.height);for(var i=1;i<s.points.length;i++)ctx.lineTo(s.points[i][0]*r.width,s.points[i][1]*r.height);if(s.points.length===1){ctx.lineTo(s.points[0][0]*r.width+.1,s.points[0][1]*r.height+.1);}ctx.stroke();});}
      function save(){try{localStorage.setItem(storageKey,JSON.stringify(strokes));}catch(e){}}
      function point(ev){var r=canvas.getBoundingClientRect();return [Math.max(0,Math.min(1,(ev.clientX-r.left)/r.width)),Math.max(0,Math.min(1,(ev.clientY-r.top)/r.height))];}
      canvas.addEventListener('pointerdown',function(e){if(e.button!==undefined&&e.button!==0)return;e.preventDefault();canvas.setPointerCapture(e.pointerId);active={color:'#30313a',width:2.5,points:[point(e)]};strokes.push(active);paint();});
      canvas.addEventListener('pointermove',function(e){if(!active)return;e.preventDefault();active.points.push(point(e));paint();});
      function end(){if(active){active=null;save();}}canvas.addEventListener('pointerup',end);canvas.addEventListener('pointercancel',end);
      document.getElementById('drawing-undo').addEventListener('click',function(){strokes.pop();paint();save();});
      document.getElementById('drawing-clear').addEventListener('click',function(){strokes=[];paint();save();});
      document.getElementById('drawing-upload').addEventListener('change',function(e){var f=e.target.files&&e.target.files[0];if(!f)return;if(!f.type.match(/^image\//)){e.target.value='';return;}var reader=new FileReader();reader.onload=function(){var im=new Image();im.onload=function(){var r=canvas.getBoundingClientRect(),ratio=Math.min(r.width/im.width,r.height/im.height),w=im.width*ratio,h=im.height*ratio;ctx.drawImage(im,(r.width-w)/2,(r.height-h)/2,w,h);try{localStorage.setItem(storageKey+'.image',reader.result);}catch(e){};};im.src=reader.result;};reader.readAsDataURL(f);});
      if(window.ResizeObserver)new ResizeObserver(size).observe(canvas);else window.addEventListener('resize',size);size();
    })();
