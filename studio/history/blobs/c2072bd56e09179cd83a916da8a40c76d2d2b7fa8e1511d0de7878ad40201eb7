-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0 book pg27-reading\" data-family=\"reference\">\n        <section data-section-type=\"boxed_text\" data-section-id=\"pg027_sec004\" class=\"b-page\">\n          <div class=\"reading-frame\">\n            <img class=\"reading-art\" src=\"studio/assets/pg027_research_art.png\" alt=\"\" aria-hidden=\"true\">\n            <h1 data-id=\"pg027_n0029\">Thello dijet</h1>\n            <div class=\"reading-copy\">\n              <p><span data-id=\"pg027_n0031\">Përpos ushqimit dhe veshmbathjes, në jetën e njeriut ka rëndësi të jashtëzakonshme edhe strehimi.</span> <span data-id=\"pg027_n0032\">Për t’u strehuar, njerëzit kanë ndërtuar lloje të ndryshme shtëpish.</span></p>\n              <p data-id=\"pg027_n0033\">Shtëpitë në vendin tonë ndryshuan me kalimin e kohës dhe kushteve ekonomike të vendit, duke filluar nga kasolle, shtëpi të ulëta, shtëpi tradicionale, kulla dhe shtëpi të reja moderne.</p>\n              <p data-id=\"pg027_n0034\">Shtëpitë tradicionale e kullat sot mbrohen, rregullohen dhe mbeten si vende të trashëgimisë e kulturës së vendit tonë.</p>\n              <p data-id=\"pg027_n0035\">Në vendin tonë, ndërtimet e vjetra janë zëvendësuar me ndërtimet e reja dhe moderne, si në fshatra, ashtu edhe në qytete.</p>\n            </div>\n          </div>\n          <aside class=\"glossary\" aria-labelledby=\"pg27-glossary-heading\">\n            <img class=\"glossary-art\" src=\"studio/assets/pg027_glossary_art.png\" alt=\"\" aria-hidden=\"true\">\n            <div class=\"glossary-copy\">\n              <h2 id=\"pg27-glossary-heading\">Fjalorthi</h2>\n              <p><strong>Qerpiç -</strong> tulla për ndërtimin e shtëpive, të bëra prej dheut.</p>\n              <p><strong>Tallë</strong> - kërcelli (trungu i misrit).</p>\n            </div>\n          </aside>\n        </section>\n      </div>\n    </main>\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n    <script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script>\n</body></html>","./pg028_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg028_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"38\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"><link rel=\"stylesheet\" href=\"./book-design/pg028.css\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container opacity-0 book\" data-family=\"response\"><section data-section-type=\"other\" data-section-id=\"pg028_sec001\" class=\"mx-auto w-full max-w-5xl bg-white text-slate-800 relative overflow-hidden px-12 py-8 max-lg:px-8 max-sm:px-0 max-sm:py-4 b-page\"><div aria-hidden=\"true\" class=\"absolute left-0 top-0 bottom-0 w-24 bg-orange-300 max-lg:w-20 max-sm:w-14 max-sm:bottom-0 max-sm:h-auto\"></div><div class=\"relative z-10 ml-28 max-lg: