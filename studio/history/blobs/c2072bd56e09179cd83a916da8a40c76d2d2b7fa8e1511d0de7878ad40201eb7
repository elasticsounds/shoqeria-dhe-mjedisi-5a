e-none focus:border-violet-500 focus:ring-2 focus:ring-violet-200\"></textarea>\n        </div>\n\n        <div class=\"text-left\">\n          <div class=\"mb-2 flex items-start gap-3 text-gray-900\">\n            <span aria-hidden=\"true\" class=\"adt-body shrink-0\">–</span>\n            <p class=\"adt-body\"><span data-id=\"pg045_n0009\">A mendon se kjo fjali paraqet respekt ndaj të tjerëve (Arsyeto përgjigjen!):</span></p>\n          </div>\n          <p class=\"adt-body mb-3 pl-8 max-sm:pl-6 text-gray-900\">\n            <span data-id=\"pg045_n0010\">“Pranoji njerëzit (shoqen dhe shokun) ashtu siç janë, pa i paragjykuar për kulturën, gjuhën apo traditat e tyre!”</span>\n          </p>\n          <label for=\"item-2\" class=\"sr-only\">A mendon se kjo fjali paraqet respekt ndaj të tjerëve (Arsyeto përgjigjen!):</label>\n          <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"A mendon se kjo fjali paraqet respekt ndaj të tjerëve (Arsyeto përgjigjen!):\" class=\"w-full min-h-11 rounded-[1.5rem] border-2 border-violet-300 bg-violet-50 px-4 py-3 text-gray-900 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-200\"></textarea>\n        </div>\n\n        <div class=\"text-left\">\n          <div class=\"mb-3 flex items-start gap-3 text-gray-900\">\n            <span aria-hidden=\"true\" class=\"adt-body shrink-0\">–</span>\n            <p class=\"adt-body\"><span data-id=\"pg045_n0012\">Diskuto me mësuesin dhe prindërit rreth kulturave të ndryshme!</span></p>\n          </div>\n          <label for=\"item-3\" class=\"sr-only\">Diskuto me mësuesin dhe prindërit rreth kulturave të ndryshme!</label>\n          <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"Diskuto me mësuesin dhe prindërit rreth kulturave të ndryshme!\" class=\"w-full min-h-11 rounded-[1.5rem] border-2 border-violet-300 bg-violet-50 px-4 py-3 text-gray-900 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-200\"></textarea>\n        </div>\n      </div>\n    </div>\n\n    <aside class=\"ml-auto w-[44%] rounded-[1.75rem] border-2 border-violet-500 bg-amber-50 px-6 py-5 max-lg:w-[58%] max-sm:w-full max-sm:ml-0 max-sm:px-5\">\n      <div class=\"flex items-start gap-4 max-sm:gap-3\">\n        <div aria-hidden=\"true\" class=\"shrink-0 pt-1 leading-none\"><img src=\"studio/assets/pg045_research_mouse.png\" alt=\"\" style=\"width:70px;height:auto\"></div>\n        <div class=\"min-w-0 flex-1 space-y-4\">\n          <p class=\"adt-body text-left text-amber-900\">\n            <span data-id=\"pg045_n0014\">Bashkë me ndihmën e prindërve apo të mësuesit, hulumto në internet dhe gjej informacione për veshjet dhe ushqimet në kulturat e ndryshme të botës.</span>\n          </p>\n          <label for=\"item-4\" class=\"sr-only\">Bashkë me ndihmën e prindërve apo të mësuesit, hulumto në internet dhe gjej informacione për veshjet dhe ushqimet në kulturat e ndryshme të botës.</label>\n          <textarea id=\"item-4\" data-activity-item=\"item-4\" aria-label=\"Bashkë me ndihmën e prindërve apo të mësuesit, hulumto në internet dhe gjej informacione për veshjet dhe ushqimet në kulturat e ndryshme të botës.\" class=\"w-full min-h-11 rounded-[1.25rem] border-2 border-amber-300 bg-white px-4 py-3 text-gray-900 outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200\"></textarea>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"rounded-[2rem] bg-[#a7cf8c] px-8 py-8 max-sm:px-5 max-sm:py-6\">\n      <div class=\"mb-6 flex items-center gap-4 max-sm:gap-3\">\n        <div aria-hidden=\"true\" class=\"leading-none b-rubric-wrapper\"><img src=\"images/pg005_im008.png\" alt=\"\" aria-hidden=\"true\" class=\"b-rubric-icon\"></div>\n        <h2 data-id=\"pg045_n0017\" class=\"adt-h2 text-left text-gray-900\">Diskuto</h2>\n      </div>\n      <div class=\"space-y-6\">\n        <div class=\"text-left\">\n          <div class=\"mb-3 flex items-start gap-3 text-gray-900\">\n            <span ar