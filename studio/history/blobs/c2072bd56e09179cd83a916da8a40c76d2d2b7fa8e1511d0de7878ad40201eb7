Transform(scale,0,0,scale,0,0);paint();}\n      function paint(){var r=canvas.getBoundingClientRect();ctx.clearRect(0,0,r.width,r.height);ctx.lineCap='round';ctx.lineJoin='round';strokes.forEach(function(s){if(!s.points||!s.points.length)return;ctx.strokeStyle=s.color||'#30313a';ctx.lineWidth=s.width||2.5;ctx.beginPath();ctx.moveTo(s.points[0][0]*r.width,s.points[0][1]*r.height);for(var i=1;i<s.points.length;i++)ctx.lineTo(s.points[i][0]*r.width,s.points[i][1]*r.height);if(s.points.length===1){ctx.lineTo(s.points[0][0]*r.width+.1,s.points[0][1]*r.height+.1);}ctx.stroke();});}\n      function save(){try{localStorage.setItem(storageKey,JSON.stringify(strokes));}catch(e){}}\n      function point(ev){var r=canvas.getBoundingClientRect();return [Math.max(0,Math.min(1,(ev.clientX-r.left)/r.width)),Math.max(0,Math.min(1,(ev.clientY-r.top)/r.height))];}\n      canvas.addEventListener('pointerdown',function(e){if(e.button!==undefined&&e.button!==0)return;e.preventDefault();canvas.setPointerCapture(e.pointerId);active={color:'#30313a',width:2.5,points:[point(e)]};strokes.push(active);paint();});\n      canvas.addEventListener('pointermove',function(e){if(!active)return;e.preventDefault();active.points.push(point(e));paint();});\n      function end(){if(active){active=null;save();}}canvas.addEventListener('pointerup',end);canvas.addEventListener('pointercancel',end);\n      document.getElementById('drawing-undo').addEventListener('click',function(){strokes.pop();paint();save();});\n      document.getElementById('drawing-clear').addEventListener('click',function(){strokes=[];paint();save();});\n      document.getElementById('drawing-upload').addEventListener('change',function(e){var f=e.target.files&&e.target.files[0];if(!f)return;if(!f.type.match(/^image\\//)){e.target.value='';return;}var reader=new FileReader();reader.onload=function(){var im=new Image();im.onload=function(){var r=canvas.getBoundingClientRect(),ratio=Math.min(r.width/im.width,r.height/im.height),w=im.width*ratio,h=im.height*ratio;ctx.drawImage(im,(r.width-w)/2,(r.height-h)/2,w,h);try{localStorage.setItem(storageKey+'.image',reader.result);}catch(e){};};im.src=reader.result;};reader.readAsDataURL(f);});\n      if(window.ResizeObserver)new ResizeObserver(size).observe(canvas);else window.addEventListener('resize',size);size();\n    })();\n  </script>\n</body></html>","./pg015_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Shoqëria dhe mjedisi</title><meta name=\"title-id\" content=\"pg015_sec001\"><meta name=\"page-section-id\" content=\"18\">\n<link href=\"./content/tailwind_output.css\" rel=\"stylesheet\"><link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\"><link href=\"./assets/fonts.css\" rel=\"stylesheet\"><link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\">\n<style>\n/* Page 15 master: source coordinates are expressed relative to its width. */\n#content.book.page15 {padding:0; container-type:inline-size; max-width:1000px;}\n#content.book.page15 .lesson15 {position:relative; width:100%; aspect-ratio:639.449 / 866.22; overflow:visible; font-family:BookAmiri,Georgia,serif; color:#30313a;}\n#content.book.page15 .lesson15 * {box-sizing:border-box;}\n#content.book.page15 .title15 {position:absolute;left:4.7%;top:1.74%;width:92.9%;height:13.4%;background:#9870b2;}\n#content.book.page15 .title15 h1 {position:absolute;left:11.7%;top:52%;margin:0;color:#fff;font:700 2.815cqw/1.2 BookPoppins,Arial,sans-serif;}\n#content.book.page15 .keywords15 {position:absolute;left:15.5%;top:13.85%;width:73.4%;height:5.2%;border:0.3cqw solid #7950aa;border-top:0;border-radius:0 0 2cqw 2cqw;background:#fff;display:flex;align-items:center;}\n#content.book.page15 .keywords15 strong {height:calc(100% + .3cqw);display:flex;align-items:center;margin-left:-.3cqw;padding:0 1.05cqw;background:#9870b2;color:#ff