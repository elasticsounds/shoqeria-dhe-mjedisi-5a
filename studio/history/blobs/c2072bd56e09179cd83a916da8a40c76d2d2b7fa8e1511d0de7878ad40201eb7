0 0 18px;font-size:19px;line-height:1.5;}\n #content.book[data-page8] .page8-diary{position:static;width:100%;}\n #content.book[data-page8] .page8-transcript{position:static;width:auto;height:auto;padding:16px;margin:18px 0 0;overflow:visible;clip:auto;white-space:normal;border:0;border-left:4px solid #f03c28;font:400 19px/1.55 BookAmiri,Georgia,serif;}\n #content.book[data-page8] .page8-transcript span:first-child{display:block;margin-bottom:8px;}\n #content.book[data-page8] .page8-folio{position:static;margin-top:22px;font-size:16px;}\n}\n@media print{#content.book[data-page8]{padding:0} #content.book[data-page8]>section{aspect-ratio:639.449/866.22}}\n</style></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 opacity-0 book\" data-family=\"illustrated-lesson\" data-page8>\n  <section data-section-type=\"text_and_single_image\" data-section-id=\"pg008_sec001\" class=\"bg-white text-slate-800 pb-10 b-page\">\n    <div class=\"-mx-8 max-sm:-mx-5 bg-purple-500 b-banner\">\n      <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-16 max-sm:py-10\">\n        <h1 class=\"adt-h2 font-bold text-white\" data-id=\"pg008_n0002\">“Jam në klasën e pestë “</h1>\n      </div>\n    </div>\n\n    <aside class=\"mt-0 mb-10 rounded-[2rem] border-4 border-purple-500 bg-white overflow-hidden b-keywords\">\n      <div class=\"flex flex-row max-lg:flex-col items-stretch\">\n        <div class=\"bg-purple-300 px-5 py-4 flex items-center border-r-4 border-purple-500 max-lg:border-r-0 max-lg:border-b-4\">\n          <span class=\"adt-body font-bold text-white b-keyword-label\" data-id=\"pg008_n0004\">Fjalët kyçe:</span>\n        </div>\n        <div class=\"px-5 py-4 flex items-center\">\n          <span class=\"adt-body\" data-id=\"pg008_n0005\">premtim, besim, përgjegjësi, ndryshim, personalitet, përvojë.</span>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"mb-8 rounded-[1.75rem] bg-sky-300 px-8 py-6 text-center shadow-sm b-panel-thought\">\n      <h3 class=\"adt-h3 font-medium text-slate-800\" data-id=\"pg008_n0007\">Jam në klasën e pestë.</h3>\n      <h3 class=\"adt-h3 font-medium text-slate-800 mt-2\" data-id=\"pg008_n0008\">Çfarë ndryshimesh kam pësuar?</h3>\n    </div>\n\n    <p class=\"adt-body leading-8 mb-8 page8-intro\">\n      <span data-id=\"pg008_n0010\">- Unë jam Ari.</span>\n      <span data-id=\"pg008_n0011\">Jetoj me nënën, babanë dhe motrën.</span>\n      <span data-id=\"pg008_n0012\">Kam një shok të pandashëm.</span>\n      <span data-id=\"pg008_n0013\">Ai është ditari im, të cilit ia tregoj të gjitha gjërat çdo ditë.</span>\n      <span data-id=\"pg008_n0014\">Sapo i tregova që po filloj klasën e pestë.</span>\n    </p>\n\n    <div class=\"clear-both page8-diary\">\n      <img data-id=\"pg008_im015\" src=\"images/pg008_im015.png\" alt=\"Faqe ditari me tekst të shkruar me dorë në një bllok me spirale të kuqe.\" class=\"w-full h-auto rounded-2xl shadow-md b-diary-photo\">\n      <div class=\"sr-only page8-transcript\">\n        <span data-id=\"pg008_n0016\">I dashur shoku im, Ditar!</span>\n        <span data-id=\"pg008_n0017\">Sot është një ditë shumë e mirë për mua dhe ndihem shumë i gëzuar.</span>\n        <span data-id=\"pg008_n0018\">Unë tani po filloj klasën e pestë!</span>\n        <span data-id=\"pg008_n0019\">I kam blerë tashmë gjërat që më duhen për shkollë dhe u ndjeva mirë kur i shfrytëzova kursimet e mia.</span>\n        <span data-id=\"pg008_n0020\">Ne, po ashtu, tash kemi marrë edhe një mace në familjen tonë, pas shumë lutjesh e kërkesash që unë dhe motra u bëmë prindërve.</span>\n        <span data-id=\"pg008_n0021\">Ata pranuan, sepse më thanë që tani jam më i rritur, , si dhe jam më i përgjegjshëm.</span>\n        <span data-id=\"pg008_n0022\">Dëshira që ta kem një mace më erdhi pasi lexova një lektyrë gjatë pushimeve, në të cilën flitej për një mace shumë të veçantë.</span>\n        <span data-id=\"pg008_n0023\">Mezi pres që këtë t’ua tregoj edhe shokëve e shoqeve në klasë!</span>\n      </div>\n    </div>\n    <div class=\"page8-folio\" aria-label=\"Faqja 8\">8</div>\n  </section>\n</div>\n    </main>\n\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n\n\n\n<script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg009_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Shoqëria dhe mjedisi</title><meta name=\"title-id\" content=\"pg009_sec001\"><meta name=\"page-section-id\" content=\"9\">\n<link href=\"./content/tailwind_output.css\" rel=\"stylesheet\"><link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\"><link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\">\n<style>\n/* The master is positioned in source-page coordinates; the phone view reflows. */\n#content.book.page-nine{container-type:inline-size;position:relative;width:100%;max-width:1000px;aspect-ratio:639.449/866.22;padding:0;margin:0 auto;background:white;overflow:visible}\n#content.book.page-nine>section{position:relative;width:100%;height:100%;padding:0}\n#content.book.page-nine .side-mark{position:absolute;left:2.35%;top:1.8%;width:2.2%;height:12.9%;background:#9b73b7}\n#content.book.page-nine .questions{position:absolute;left:13.3%;top:7.9%;width:84.3%;height:12%;border:2px solid #7950aa;border-right:0;border-radius:0 0 0 18px;padding:0}\n#content.book.page-nine .questions img{position