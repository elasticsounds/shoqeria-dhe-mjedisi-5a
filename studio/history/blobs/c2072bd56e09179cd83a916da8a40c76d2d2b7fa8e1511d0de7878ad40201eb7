keywords strong{position:static;display:inline-block;border:0;border-radius:6px;font-size:18px;padding:5px 8px;margin-right:5px}\n#content.book.page32 .p32-thought{padding:16px;border-radius:14px}\n#content.book.page32 .p32-thought img{position:static;float:left;width:52px;margin-right:12px}\n#content.book.page32 .p32-thought h2{position:static;font-size:23px}\n#content.book.page32 .p32-thought ul{position:static;clear:both;padding-top:10px}\n#content.book.page32 .p32-thought li{font-size:16px;line-height:1.5;white-space:normal;margin-bottom:5px}\n#content.book.page32 .p32-open{position:static;min-height:44px;margin-top:10px;padding:8px 12px;font-size:16px}\n#content.book.page32 .p32-photo{align-self:center;max-height:330px;max-width:75%;object-fit:contain}\n#content.book.page32 p.p32-copy{font:400 18px/1.5 BookAmiri,Georgia,serif;text-align:left}\n#content.book.page32 .p32-figure{align-self:center;max-width:65%;text-align:center}\n#content.book.page32 .p32-figure img{max-height:330px;width:auto;max-width:100%;margin:auto}\n#content.book.page32 .p32-figure figcaption{position:static;font-size:18px;margin-top:5px}\n#content.book.page32 .p32-folio{font-size:16px}\n}\n@media print{#content.book.page32 .p32-open,#content.book.page32 dialog{display:none}}\n</style></head>\n<body class=\"min-h-screen flex items-center justify-center\"><main class=\"w-full\">\n<div id=\"content\" class=\"container mx-auto opacity-0 book page32\" data-family=\"illustrated-lesson\">\n<section data-section-type=\"text_and_images\" data-section-id=\"pg032_sec001\" class=\"b-page\">\n<header class=\"p32-banner\"><h1 data-id=\"pg032_n0002\">Veshjet tradicionale kosovare</h1></header>\n<div class=\"p32-keywords\"><strong data-id=\"pg032_n0004\">Fjalët kyçe:</strong><span data-id=\"pg032_n0005\">veshje tradicionale, trashëgimi kulturore, vlerë, traditë.</span></div>\n<aside class=\"p32-thought\" aria-labelledby=\"p32-thought-title\"><img src=\"images/pg005_im002.png\" alt=\"\"><h2 id=\"p32-thought-title\" data-id=\"pg032_n0008\">Shpreh mendimin tënd</h2><ul>\n<li data-id=\"pg032_n0011\">A e di se populli ynë ka shumë veshje tradicionale?</li><li data-id=\"pg032_n0013\">Në cilat raste vishen ato?</li><li data-id=\"pg032_n0015\">Analizoji fotografitë me informacionet e dhëna!</li></ul>\n<button class=\"p32-open\" type=\"button\" onclick=\"document.getElementById('p32-responses').showModal()\" aria-haspopup=\"dialog\">Përgjigju</button></aside>\n<img class=\"p32-photo p32-man\" src=\"images/pg032_im003.png\" data-id=\"pg032_im003\" alt=\"Veshje tradicionale burrash me tirq të bardhë të zbukuruar me gajtanë të zinj, brez në mes, mbulesë të bardhë të kokës dhe opinga.\">\n<p class=\"p32-copy p32-men-copy\"><span data-id=\"pg032_n0018\">Veshjet tradicionale të burrave zakonisht përbëhen nga një këmishë e bardhë dhe tirqit të punuar prej shajaku.</span> <span data-id=\"pg032_n0019\">Tirqit janë të zbukuruar me gajtanë me ngjyrë të zezë.</span> <span data-id=\"pg032_n0020\">Rreth tirqve është e vendosur shoka.</span> <span data-id=\"pg032_n0021\">Në kokë mbahet plisi, si simbol i shqiptarëve.</span> <span data-id=\"pg032_n0022\">Në disa treva, si në Rugovë p.sh., koka lidhet edhe me shall.</span> <span data-id=\"pg032_n0023\">Si mbathje janë përdorur opingat.</span></p>\n<img class=\"p32-photo p32-dress\" src=\"images/pg032_im004.png\" data-id=\"pg032_im004\" alt=\"Xhubletë e zezë me fund të valëzuar, e zbukuruar me shirita dhe ornamente shumëngjyrëshe.\">\n<p class=\"p32-copy p32-dress-copy\"><span data-id=\"pg032_n0025\">Xhubleta është veshje me skaj të valëzuar si zile, e cila mbahet nga dy shiritat mbi supe, vishet me një këmishë të bardhë prej liri me mëngë të gjata.</span> <span data-id=\"pg032_n0026\">Në këmbë mbathen çorapë leshi dhe opinga.</span> <span data-id=\"pg032_n0027\">Kjo veshje tradicionale shqiptare mbrohet nga UNESCO-ja.</span></p>\n<figure class=\"p32-figure p32-duka\"><img src=\"images/pg032_im005.png\" data-id=\"pg032_im005\" alt=\"Veshje e Dukagjinit për gra, me fustan të bardhë, jelek të kuq, shall me thekë në bel, çorape të errëta dhe opinga.\"><figcaption data-id=\"pg032_n0037\">Veshje e Dukagjinit</figcaption></figure>\n<p class=\"p32-copy p32-women-copy\"><span data-id=\"pg032_n0030\">Pothuajse të gjitha veshjet e grave janë të përbëra nga një këmishë e bardhë e gjatë, me mëngë të gjata, skajet e së cilës janë të qëndisura me ngjyra.</span> <span data-id=\"pg032_n0031\">Sipër, gratë mbajnë një jelek të zbukuruar me fije të arta.</span> <span data-id=\"pg032_n0032\">Dy pështjellakë janë gjithashtu karakteristikë e këtyre veshjeve.</span> <span data-id=\"pg032_n0033\">Çorapët janë prej leshi dhe opingat prej lëkure.</span> <span data-id=\"pg032_n0034\">Veshjet dallojnë sipas moshave; zakonisht veshjet e vajzave janë më të stolisura se ato të grave.</span></p>\n<figure class=\"p32-figure p32-hasi\"><img src=\"images/pg032_im001.png\" data-id=\"pg032_im001\" alt=\"Veshje e Hasit për gra, me këmishë të çelët, jelek rozë dhe përparëse e fund të mbuluar me qëndisje e motive shumëngjyrëshe.\"><figcaption data-id=\"pg032_n0036\">Veshje e Hasit</figcaption></figure>\n<div class=\"p32-folio\">32</div>\n<dialog id=\"p32-responses\" aria-labelledby=\"p32-dialog-title\"><h2 id=\"p32-dialog-title\">Shpreh mendimin tënd</h2><p>Përgjigjet ruhen automatikisht në këtë pajisje.</p>\n<label for=\"item-1\">A e di se populli ynë ka shumë veshje tradicionale?</label><textarea id=\"item-1\" data-activity-item=\"item-1\"></textarea>\n<label for=\"item-2\">Në cilat raste vishen ato?</label><textarea id=\"item-2\" data-activity-item=\"item-2\"></textarea>\n<label for=\"item-3\">Analizoji fotografitë me informacionet e dhëna!</label><textarea id=\"item-3\" data-activity-item=\"item-3\"></textarea>\n<button type=\"button\" onclick=\"document.getElementById('p32-responses').close()\">Mbyll</button></dialog>\n</section></div></main>\n<div class=\"relative z-50\" id=\"interface-container\"></div><div class=\"relative z-50\" id=\"nav-container\"></div>\n<script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script><script src=\"./assets/scorm.js\"></script><script src=\"./assets/base.bundle.local.js\"></script><script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg033_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg033_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"49\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 opacity-0 book\" data-family=\"reference\"><section data-section-type=\"boxed_text\" data-section-id=\"pg033_sec001\" class=\"py-8 b-page\"><div class=\"rounded-[2rem] border-4 border-purple-500 bg-white px-8 py-6 shadow-[0_8px_24px_rgba(168,85,247,0.12)] max-sm:px-5\"><div class=\"mb-6 flex items-start gap-4\"><div aria-hidden=\"true\" class=\"leading-none b-rubric-wrapper\"><img src=\"images/pg005_im006.png\" alt=\"\" aria-hidden=\"true\" class=\"b-rubric-icon\"></div><h1 data-id=\"pg033_n0003\" class=\"adt-h2 font-semibold text-purple-700\