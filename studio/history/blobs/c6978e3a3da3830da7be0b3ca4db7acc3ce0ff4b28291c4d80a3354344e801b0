-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 opacity-0 book\" data-family=\"illustrated-lesson\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg038_sec001\" class=\"bg-white text-slate-800 b-page\">\n    <div class=\"-mx-8 max-sm:-mx-5 bg-[#a173b4] b-banner\">\n      <div class=\"mx-auto flex min-h-[220px] w-full max-w-5xl items-center px-8 py-12 max-sm:min-h-[155px] max-sm:px-5 max-sm:py-10\">\n        <h1 class=\"adt-h1 font-bold text-white\" data-id=\"pg038_n0002\">Profesionet tona</h1>\n      </div>\n    </div>\n\n    <div class=\"mt-6 max-w-[900px] overflow-hidden rounded-[2rem] border-4 border-purple-500 bg-white\">\n      <div class=\"flex items-stretch max-sm:flex-col\">\n        <div class=\"flex shrink-0 items-center bg-[#b47adf] px-5 py-4 max-sm:w-full\">\n          <div class=\"adt-body whitespace-nowrap font-bold text-white b-keyword-label\" data-id=\"pg038_n0004\">Fjalët kyçe:</div>\n        </div>\n        <div class=\"flex flex-1 items-center px-5 py-4\">\n          <p class=\"adt-body text-slate-700\"><span data-id=\"pg038_n0005\">profesion, mjete, zanat, përkushtim.</span></p>\n        </div>\n      </div>\n    </div>\n\n    <aside class=\"mt-4 max-w-[900px] rounded-[1.75rem] bg-[#8ec8dc] px-5 py-4 shadow-sm\">\n      <div class=\"flex gap-5 max-sm:flex-col max-sm:gap-3\">\n        <div aria-hidden=\"true\" class=\"flex h-24 w-24 shrink-0 items-center justify-center self-start rounded-full border-2 border-slate-500 bg-white/95 max-sm:h-20 max-sm:w-20 b-rubric-wrapper\"><img src=\"images/pg005_im002.png\" alt=\"\" aria-hidden=\"true\" class=\"b-rubric-icon\"></div>\n        <div class=\"flex-1\">\n          <h2 class=\"adt-h2 font-medium leading-tight text-slate-800\" data-id=\"pg038_n0008\">Shpreh mendimin tënd</h2>\n          <ul class=\"mt-3 space-y-3\">\n            <li>\n              <p class=\"adt-body leading-snug\"><span data-id=\"pg038_n0011\">Cilat janë profesionet e prindërve të tu?</span></p>\n              <label for=\"item-1\" class=\"sr-only\">Cilat janë profesionet e prindërve të tu?</label>\n              <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"Cilat janë profesionet e prindërve të tu?\" class=\"mt-2 min-h-11 w-full rounded-xl border border-sky-500 bg-white/90 px-3 py-2 outline-none focus:border-purple-500\" rows=\"2\"></textarea>\n            </li>\n            <li>\n              <p class=\"adt-body leading-snug\"><span data-id=\"pg038_n0013\">Çfarë mjete të punës përdorin ata?</span></p>\n              <label for=\"item-2\" class=\"sr-only\">Çfarë mjete të punës përdorin ata?</label>\n              <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Çfarë mjete të punës përdorin ata?\" class=\"mt-2 min-h-11 w-full rounded-xl border border-sky-500 bg-white/90 px-3 py-2 outline-none focus:border-purple-500\" rows=\"2\"></textarea>\n            </li>\n            <li>\n              <p class=\"adt-body leading-snug\"><span data-id=\"pg038_n0015\">Analizo fotografitë me informacionet e dhëna!</span></p>\n              <label for=\"item-3\" class=\"sr-only\">Analizo fotografitë me informacionet e dhëna!</label>\n              <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"Analizo fotografitë me informacionet e dhëna!\" class=\"mt-2 min-h-11 w-full rounded-xl border border-sky-500 bg-white/90 px-3 py-2 outline-none focus:border-purple-500\" rows=\"2\"></textarea>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </aside>\n\n    <p class=\"adt-body mt-6 max-w-[980px] leading-relaxed\"><span data-id=\"pg038_n0017\">Në një panair të profesioneve, ishin paraqitur me fotografi dhe përshkrim profesionet e ndryshme dhe mjetet e tyre.</span></p>\n\n    <div class=\"mt-4 max-w-[980px] space-y-3\">\n      <div class=\"flex items-start gap-2 max-sm:flex-col max-sm:gap-3\">\n        <img src=\"images/pg038_im002.png\" alt=\"Vegla të vjetra zdrukthëtarie\" data-id=\"pg038_im002\" class=\"h-auto w-60 object-cover max-sm:w-full\">\n        <p class=\"adt-body flex-1 leading-relaxed\"><span data-id=\"pg038_n0020\">Zdrukthëtaria është profesion i vjetër.</span> <span data-id=\"pg038_n0021\">Zdrukthëtarët merreshin me punime druri dhe krijonin gjëra të ndryshme me vegla mjaft të thjeshta.</span></p>\n      </div>\n\n      <div class=\"flex items-start gap-2 max-sm:flex-col max-sm:gap-3\">\n        <img src=\"images/pg038_im003.png\" alt=\"Makineri moderne për përpunimin e drurit\" data-id=\"pg038_im003\" class=\"h-auto w-60 object-cover max-sm:w-full\">\n        <p class=\"adt-body flex-1 leading-relaxed\"><span data-id=\"pg038_n0024\">Sot, druri përpunohet nëpër fabrika me makineri moderne.</span> <span data-id=\"pg038_n0025\">Për një kohë të shkurtër punohen vegla, dyer, dritare e mobilie për shtëpi e institucione të ndryshme.</span></p>\n      </div>\n\n      <div class=\"flex items-start gap-2 max-sm:flex-col max-sm:gap-3\">\n        <img src=\"images/pg038_im004.png\" alt=\"Rrush duke u përzier për prodhimin e verës\" data-id=\"pg038_im004\" class=\"h-auto w-60 object-cover max-sm:w-full\">\n        <p class=\"adt-body flex-1 leading-relaxed\"><span data-id=\"pg038_n0028\">Kosova njihet për vreshtat dhe kultivimin e rrushit të tryezës dhe atij të verës.</span> <span data-id=\"pg038_n0029\">Prodhimi i verës është traditë e vjetër e vendit tonë.</span> <span data-id=\"pg038_n0030\">I tërë rrushi për verë ndrydhej me këmbë ose me ndonjë shkop.</span></p>\n      </div>\n\n      <div class=\"flex items-start gap-2 max-sm:flex-col max-sm:gap-3\">\n        <img src=\"images/pg038_im005.png\" alt=\"Pajisje bashkëkohore për prodhimin e verës\" data-id=\"pg038_im005\" class=\"h-auto w-60 object-cover max-sm:w-full\">\n        <p class=\"adt-body flex-1 leading-relaxed\"><span data-id=\"pg038_n0033\">Në ditët e sotme, vera prodhohet në fabrika bashkëkohore.</span> <span data-id=\"pg038_n0034\">Shtrydhja e rrushit bëhet me makina e, më pas, të gjitha procedurat deri te mbushja e shisheve shkojnë në linja të veçanta të fabrikës.</span></p>\n      </div>\n\n      <div class=\"flex items-start gap-2 max-sm:flex-col max-sm:gap-3\">\n        <div class=\"flex w-60 flex-col gap-3 max-sm:w-full\">\n          <img src=\"images/pg038_im006.png\" alt=\"Makina e shkrimit\" data-id=\"pg038_im006\" class=\"h-auto w-full object-cover\">\n          <img src=\"images/pg038_im007.png\" alt=\"Kompjuter për dërgimin dhe marrjen e lajmeve\" data-id=\"pg038_im007\" class=\"h-auto w-full object-cover\">\n        </div>\n        <p class=\"adt-body flex-1 leading-relaxed\"><span data-id=\"pg038_n0037\">Profesioni i gazetarisë mundëson prodhimin dhe shpërndarjen e lajmeve.</span> <span data-id=\"pg038_n0038\">Mjete pune të gazetarit në të kaluarën ishin: fletorja, lapsi dhe një makinë shkrimi.</span> <span data-id=\"pg038_n0039\">Mbledhja e informacioneve ishte shumë e vështirë.</span> <span data-id=\"pg038_n0040\">Me zhvillimin e teknologjisë, u shpikën mjete të ndryshme informacioni, si: telegrafi, radioja, televizori etj., të cilat mundësojnë që mbledhja e informacionit të bëhet më shpejt.</span> <span data-id=\"pg038_n0041\">Sot, interneti ka mundësuar dërgimin dhe marrjen e menjëhershme të lajmeve në tërë botën.</span></p>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n\n\n\n<script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg039_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg039_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"76\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 py-8 max-sm:px-5 bg-white opacity-0 book\" data-family=\"illustrated-lesson\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg039_sec001\" class=\"w-full b-page\">\n    <div class=\"mb-8 grid grid-cols-4 gap-4 max-lg:grid-cols-2 max-sm:grid-cols-1\">\n      <img data-id=\"pg039_im003\" src=\"images/pg039_im003.png\" alt=\"Stetoskop i kuq për kontrollimin e pacientëve.\" class=\"h-56 w-full rounded-2xl bg-slate-100 object-cover shadow-sm max-lg:h-44 max-sm:h-auto\">\n      <img data-id=\"pg039_im004\" src=\"images/pg039_im004.png\" alt=\"Shiringë, shishe ilaçesh dhe tableta për mjekim.\" class=\"h-56 w-full rounded-2xl bg-slate-100 object-cover shadow-sm max-lg:h-44 max-sm:h-auto\">\n      <img data-id=\"pg039_im005\" src=\"images/pg039_im005.png\" alt=\"Monitor me imazhe skanimi mjekësor të trupit.\" class=\"h-56 w-full rounded-2xl bg-slate-100 object-cover shadow-sm max-lg:h-44 max-sm:h-auto\">\n      <img data-id=\"pg039_im006\" src=\"images/pg039_im006.png\" alt=\"Pajisje moderne mjekësore për ekzaminime në spital.\" class=\"h-56 w-full rounded-2xl bg-slate-100 object-cover shadow-sm max-lg:h-44 max-sm:h-auto\">\n    </div>\n\n    <p class=\"adt-body mb-8 text-left leading-8 text-slate-800\">\n      <span data-id=\"pg039_n0002\">Profesioni i mjekut është shumë i rëndësishëm.</span>\n      <span data-id=\"pg039_n0003\">Ai kujdeset për shëndetin e njerëzve.</span>\n      <span data-id=\"pg039_n0004\">Mjeku ndihmon në zbulimin dhe mjekimin e sëmundjeve.</span>\n      <span data-id=\"pg039_n0005\">Pas shkollimit, mjeku premton se do t’i ndihmojë pacientët gjatë gjithë jetës së tij.</span>\n      <span data-id=\"pg039_n0006\">Dikur, mjekët punonin edhe pa pajisje moderne – ata përdornin stetoskopin për t’i kontrolluar pacientët dhe për të zbuluar sëmundje.</span>\n      <span data-id=\"pg039_n0007\">Sot, ky profesion është përmirësuar shumë, sepse ka pajisje të reja dhe teknologji moderne.</span>\n    </p>\n\n    <div class=\"mb-10 rounded-[2rem] border-2 border-purple-300 bg-purple-50 px-6 py-5 max-sm:px-4\">\n      <h1 data-id=\"pg039_n0009\" class=\"adt-h3 mb-2 text-left italic text-purple-900\">Mos harro!</h1>\n      <p class=\"adt-body text-left italic leading-8 text-slate-800\">\n        <span data-id=\"pg039_n0010\">Të gjitha profesionet janë të domosdoshme dhe të rëndësishme që të funksionojë jeta në shoqëri.</span>\n      </p>\n    </div>\n\n    <aside class=\"mb-10 rounded-[2rem] border-2 border-green-400 bg-green-300 px-6 py-6 shadow-sm max-sm:px-4 b-panel-discussion\" aria-labelledby=\"pg039_n0013\">\n      <h2 data-id=\"pg039_n0013\" class=\"adt-h2 mb-5 text-left text-slate-900\">Diskuto</h2>\n      <div class=\"space-y-6\">\n        <div>\n          <p class=\"adt-body text-left leading-8 text-slate-900\">\n            <span data-id=\"pg039_n0016\">Cilat nga zanatet janë në zhdukje në Kosovë?</span>\n          </p>\n          <label for=\"item-1\" class=\"sr-only\">Cilat nga zanatet janë në zhdukje në Kosovë?</label>\n          <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"Cilat nga zanatet janë në zhdukje në Kosovë?\" class=\"mt-2 min-h-11 w-full rounded-2xl border-2 border-green-700 bg-white px-4 py-3 text-slate-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n        </div>\n        <div>\n          <p class=\"adt-body text-left leading-8 text-slate-900\">\n            <span data-id=\"pg039_n0018\">Cilat janë masat që po merren për vazhdimin e punës së tyre?</span>\n          </p>\n          <label for=\"item-2\" class=\"sr-only\">Cilat janë masat që po merren për vazhdimin e punës së tyre?</label>\n          <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Cilat janë masat që po merren për vazhdimin e punës së tyre?\" class=\"mt-2 min-h-11 w-full rounded-2xl border-2 border-green-700 bg-white px-4 py-3 text-slate-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n        </div>\n        <div>\n          <p class=\"adt-body text-left leading-8 text-slate-900\">\n            <span data-id=\"pg039_n0020\">Analizo: cili nga zanatet mendon se duhet të vazhdojë?</span>\n            <span data-id=\"pg039_n0021\">Pse?</span>\n          </p>\n          <label for=\"item-3\" class=\"sr-only\">Analizo: cili nga zanatet mendon se duhet të vazhdojë? Pse?</label>\n          <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"Analizo: cili nga zanatet mendon se duhet të vazhdojë? Pse?\" class=\"mt-2 min-h-11 w-full rounded-2xl border-2 border-green-700 bg-white px-4 py-3 text-slate-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"rounded-[2rem] border-4 border-purple-400 bg-white px-6 py-6 shadow-sm max-sm:px-4 b-panel-reading\">\n      <h2 data-id=\"pg039_n0024\" class=\"adt-h2 mb-4 text-left text-slate-900\">Thello dijet</h2>\n      <p class=\"adt-body text-left leading-8 text-slate-800\">\n        <span data-id=\"pg039_n0026\">Profesioni është një punë që kryhet nga një person i përgatitur në mënyrë të veçantë, qoftë përmes arsimit, qoftë përmes kurseve trajnuese.</span>\n        <span data-id=\"pg039_n0027\">Njeriu zgjedh profesionin që ka dëshirë dhe mëson e specializohet për ta kryer atë punë.</span>\n        <span data-id=\"pg039_n0028\">Secili profesion ka rëndësinë e tij.</span>\n        <span data-id=\"pg039_n0029\">Puna në vendin tonë dikur është kryer me vështirësi për shkak të mungesës së mjeteve të punës.</span>\n        <span data-id=\"pg039_n0030\">Me zhvillimin e teknologjisë, sot, edhe te ne, si në të gjitha vendet e botës, puna kryhet me mjete bashkëkohore.</span>\n        <span data-id=\"pg039_n0031\">Çdo profesion që ka njeriu, duhet të bëhet me përkushtim dhe përgjegjësi.</span>\n      </p>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n\n\n\n<script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg039_sec002.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg039_sec002\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"77\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-4 opacity-0 book\" data-family=\"response\">\n  <section data-section-type=\"other\" data-section-id=\"pg039_sec002\" class=\"py-8 b-page\">\n    <div class=\"rounded-[2rem] border-4 border-purple-500 bg-white px-10 py-8 shadow-[0_8px_24px_rgba(168,85,247,0.10)] max-lg:px-8 max-lg:py-7 max-sm:px-6 max-sm:py-6\">\n      <div class=\"mb-6 flex items-center gap-4 max-sm:gap-3\">\n        <div aria-hidden=\"true\" class=\"flex shrink-0 items-end gap-1 text-purple-500 b-rubric-wrapper\"><img src=\"images/pg005_im006.png\" alt=\"\" aria-hidden=\"true\" class=\"b-rubric-icon\"></div>\n        <h1 class=\"adt-h2 text-left font-semibold text-purple-700\" data-id=\"pg039_n0034\">Pyetje për ty</h1>\n      </div>\n\n      <div class=\"space-y-6 text-left text-slate-800\">\n        <div>\n          <p class=\"adt-body\" data-id=\"pg039_n0035\">Cilat profesione u panë në panair?</p>\n          <label for=\"item-1\" class=\"sr-only\">Cilat profesione u panë në panair?</label>\n          <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"Cilat profesione u panë në panair?\" class=\"mt-3 min-h-11 w-full rounded-2xl border-2 border-purple-200 bg-purple-50 px-4 py-3 text-slate-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n        </div>\n\n        <div>\n          <p class=\"adt-body\" data-id=\"pg039_n0036\">Pse ushtrimi i profesionit ishte më i vështirë dikur?</p>\n          <label for=\"item-2\" class=\"sr-only\">Pse ushtrimi i profesionit ishte më i vështirë dikur?</label>\n          <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Pse ushtrimi i profesionit ishte më i vështirë dikur?\" class=\"mt-3 min-h-11 w-full rounded-2xl border-2 border-purple-200 bg-purple-50 px-4 py-3 text-slate-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n        </div>\n\n        <div>\n          <p class=\"adt-body\" data-id=\"pg039_n0037\">Çfarë e lehtësoi punën në secilin profesion?</p>\n          <label for=\"item-3\" class=\"sr-only\">Çfarë e lehtësoi punën në secilin profesion?</label>\n          <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"Çfarë e lehtësoi punën në secilin profesion?\" class=\"mt-3 min-h-11 w-full rounded-2xl border-2 border-purple-200 bg-purple-50 px-4 py-3 text-slate-900 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n        </div>\n\n        <div class=\"pt-1\">\n          <p class=\"adt-body\" data-id=\"pg039_n0038\">Shkruaj për profesionin që dëshiron ta ushtrosh në të ardhmen!</p>\n          <p class=\"adt-body\" data-id=\"pg039_n0039\">Përmend përgjegjësitë dhe rëndësinë që ka ai prefesion!</p>\n\n          <div class=\"mt-5 space-y-3\">\n            <div>\n              <span class=\"sr-only\" data-id=\"pg039_n0040\"></span>\n              <label for=\"item-4\" class=\"sr-only\">Shkruaj përgjigjen në rreshtin e parë për profesionin që dëshiron ta ushtrosh në të ardhmen</label>\n              <input id=\"item-4\" type=\"text\" data-activity-item=\"item-4\" aria-label=\"Shkruaj përgjigjen në rreshtin e parë për profesionin që dëshiron ta ushtrosh në të ardhmen\" class=\"min-h-11 w-full border-0 border-b-2 border-slate-500 bg-transparent px-1 py-2 text-slate-900 outline-none focus:border-purple-500 focus:ring-0\">\n            </div>\n            <div>\n              <span class=\"sr-only\" data-id=\"pg039_n0041\"></span>\n              <label for=\"item-5\" class=\"sr-only\">Shkruaj përgjigjen në rreshtin e dytë për përgjegjësitë dhe rëndësinë e profesionit</label>\n              <input id=\"item-5\" type=\"text\" data-activity-item=\"item-5\" aria-label=\"Shkruaj përgjigjen në rreshtin e dytë për përgjegjësitë dhe rëndësinë e profesionit\" class=\"min-h-11 w-full border-0 border-b-2 border-slate-500 bg-transparent px-1 py-2 text-slate-900 outline-none focus:border-purple-500 focus:ring-0\">\n            </div>\n            <div>\n              <span class=\"sr-only\" data-id=\"pg039_n0042\"></span>\n              <label for=\"item-6\" class=\"sr-only\">Shkruaj përgjigjen në rreshtin e tretë për profesionin</label>\n              <input id=\"item-6\" type=\"text\" data-activity-item=\"item-6\" aria-label=\"Shkruaj përgjigjen në rreshtin e tretë për profesionin\" class=\"min-h-11 w-full border-0 border-b-2 border-slate-500 bg-transparent px-1 py-2 text-slate-900 outline-none focus:border-purple-500 focus:ring-0\">\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n\n\n\n<script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg040_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg040_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n     