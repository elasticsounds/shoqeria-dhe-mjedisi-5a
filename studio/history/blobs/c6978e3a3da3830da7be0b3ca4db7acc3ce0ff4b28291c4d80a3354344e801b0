\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 opacity-0 book\" data-family=\"chapter-lesson\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg044_sec001\" class=\"bg-white pb-8 text-slate-800 b-page\">\n    <div class=\"-mx-8 bg-[#a373b6] max-sm:-mx-5 b-banner\">\n      <div class=\"mx-auto w-full max-w-5xl px-8 py-14 max-sm:px-5 max-sm:py-10\">\n        <h1 class=\"adt-h1 font-bold text-white\" data-id=\"pg044_n0002\">Të ndryshëm, por të barabartë</h1>\n        <p class=\"adt-body mt-2 text-white\"><span data-id=\"pg044_n0003\" class=\"b-chapter-subtitle\">Kultura, gjuha, tradita dhe vlerat njerëzore</span></p>\n      </div>\n    </div>\n\n    <div class=\"mt-4 rounded-[2rem] border-4 border-[#9f49f2] bg-white px-6 py-5 max-sm:px-4\">\n      <p class=\"adt-body text-left leading-relaxed text-slate-800\">\n        <span data-id=\"pg044_n0005\" class=\"mr-3 inline-block rounded-[1.4rem] border-2 border-[#8d4aa8] bg-[#b78bd0] px-4 py-3 font-semibold text-white b-keyword-label\">Fjalët kyçe:</span><span data-id=\"pg044_n0006\">gjuhë, kulturë, traditë, zakon, vlera njerëzore.</span>\n      </p>\n    </div>\n\n    <div class=\"mt-8 rounded-[2rem] bg-[#8cc4d8] p-6 max-sm:p-4\">\n      <div class=\"overflow-hidden rounded-[1.75rem] bg-[#8cc4d8]\">\n        <div class=\"float-right ml-8 mb-4 w-[33%] rounded-[1.8rem] border-2 border-[#7ab2d3] bg-[#fff0bf] p-5 max-lg:w-[36%] max-sm:float-none max-sm:ml-0 max-sm:mb-5 max-sm:w-full max-sm:p-4\">\n          <div class=\"space-y-4\">\n            <div>\n              <label for=\"item-1\" class=\"sr-only\">Emri dhe mbiemri</label>\n              <input id=\"item-1\" data-activity-item=\"item-1\" type=\"text\" aria-label=\"Emri dhe mbiemri\" placeholder=\"Emri dhe mbiemri\" class=\"min-h-11 w-full rounded-[1.2rem] border-2 border-[#f2c22b] bg-white px-4 py-3 text-slate-800 outline-none placeholder:text-slate-700 focus:border-purple-500\">\n            </div>\n            <div>\n              <label for=\"item-2\" class=\"sr-only\">Gjuha amtare</label>\n              <input id=\"item-2\" data-activity-item=\"item-2\" type=\"text\" aria-label=\"Gjuha amtare\" placeholder=\"Gjuha amtare\" class=\"min-h-11 w-full rounded-[1.2rem] border-2 border-[#f2c22b] bg-white px-4 py-3 text-slate-800 outline-none placeholder:text-slate-700 focus:border-purple-500\">\n            </div>\n            <div>\n              <label for=\"item-3\" class=\"sr-only\">Kombësia</label>\n              <input id=\"item-3\" data-activity-item=\"item-3\" type=\"text\" aria-label=\"Kombësia\" placeholder=\"Kombësia\" class=\"min-h-11 w-full rounded-[1.2rem] border-2 border-[#f2c22b] bg-white px-4 py-3 text-slate-800 outline-none placeholder:text-slate-700 focus:border-purple-500\">\n            </div>\n          </div>\n        </div>\n\n        <div class=\"rounded-[1.75rem] bg-[#79b6c8] p-4 max-sm:p-3\">\n          <img src=\"images/pg044_im004.png\" alt=\"Fëmijë që komunikojnë dhe bashkëpunojnë me njëri-tjetrin\" data-id=\"pg044_im004\" class=\"w-full h-auto rounded-[1.25rem]\">\n        </div>\n\n        <h2 class=\"adt-h2 mt-4 text-slate-900\" data-id=\"pg044_n0008\">Shpreh mendimin tënd</h2>\n        <p class=\"adt-body mt-4 clear-both text-left text-slate-900\"><span data-id=\"pg044_n0009\">Njerëzit janë qenie të gjalla që flasin dhe bashkëpunojnë me njëri-tjetrin, duke përdorur të njëjtën gjuhë me zë, me fjalë ose me shenja.</span></p>\n      </div>\n    </div>\n\n    <div class=\"mt-8 space-y-2 text-left text-slate-900\">\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0011\">Situatë: Një ditë, nxënësit e klasës së pestë vendosën që të diskutonin për llojllojshmërinë etnike dhe kulturore.</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0012\">Ata u ulën në formë rrethore dhe filluan që të flisnin me radhë.</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0013\">Ana mori fjalën e para dhe tha se ne na bashkojnë shumë gjëra.</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0014\">“Po”, - ndërhyri menjëherë Lisi.</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0015\">“Të gjithë ne flasim, ecim, mendojmë dhe kujdesemi për njëri-tjetrin”.</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0016\">“Unë dua të di,- tha Mati, - se nga se ndryshojnë njerëzit?</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0017\">“Njerëzit ndryshojnë nga përkatësia kombëtare, gjuha që flasin, vendi ku jetojnë etj.”, nxitoi të fliste Era.</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0018\">“Ne kemi traditat, veshjet, ushqimin tonë, vlerat njerëzore që nuk i harrojmë edhe kur largohemi nga vendlindja jonë”, tha Meritoni me krenari.</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0019\">Nxënësit diskutuan gjatë midis tyre dhe në fund kuptuan se kulturat duhen respektuar gjithmonë nga të gjithë.</span></p>\n      <p class=\"adt-body leading-relaxed\"><span data-id=\"pg044_n0020\">Në fund, ata përqafuan njëri-tjetrin duke buzëqeshur.</span></p>\n    </div>\n\n    <div class=\"mt-8\">\n      <img src=\"images/pg044_im002.png\" alt=\"Nxënës që ecin së bashku në shkollë\" data-id=\"pg044_im002\" class=\"w-full h-auto rounded-lg\">\n    </div>\n  </section>\n</div>\n    </main>\n\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n  