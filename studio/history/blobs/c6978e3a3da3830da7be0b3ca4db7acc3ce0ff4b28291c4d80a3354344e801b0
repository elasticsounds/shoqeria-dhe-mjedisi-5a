e left-1/2 right-1/2 -mx-[50vw] w-screen bg-[#a476b5] b-banner\">\n      <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-12 max-sm:py-8\">\n        <h1 class=\"adt-h1 font-bold text-white max-w-4xl leading-tight\" data-id=\"pg029_n0002\">Ndryshimi i objekteve dhe i mjeteve të punës gjatë kohës</h1>\n      </div>\n    </div>\n\n    <div class=\"-mt-3 mb-8 max-sm:mb-6\">\n      <div class=\"rounded-[1.8rem] border-4 border-purple-500 bg-white overflow-hidden\">\n        <div class=\"flex items-stretch max-sm:flex-col\">\n          <div class=\"bg-[#b57adf] px-5 py-4 flex items-center rounded-r-[1.4rem] max-sm:rounded-r-none max-sm:rounded-b-none\">\n            <span class=\"adt-body font-bold text-white whitespace-nowrap b-keyword-label\" data-id=\"pg029_n0004\">Fjalët kyçe:</span>\n          </div>\n          <div class=\"flex-1 px-5 py-4 flex items-center\">\n            <span class=\"adt-body text-slate-800\" data-id=\"pg029_n0005\">objekt, ndryshim, përmirësim, mjete bashkëkohore.</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <aside class=\"mb-6 rounded-[1.8rem] bg-sky-300 px-5 py-4 shadow-sm b-panel-thought\">\n      <div class=\"flex gap-4 max-sm:flex-col max-sm:items-center max-sm:text-left\">\n        <div class=\"shrink-0 flex items-start justify-center pt-1 max-sm:pt-0 b-rubric-wrapper\" aria-hidden=\"true\"><img src=\"images/pg005_im002.png\" alt=\"\" aria-hidden=\"true\" class=\"b-rubric-icon\"></div>\n        <div class=\"flex-1\">\n          <h2 class=\"adt-h2 font-semibold mb-2 text-slate-900\" data-id=\"pg029_n0007\">Shpreh mendimin tënd</h2>\n          <ul class=\"space-y-3\">\n            <li class=\"adt-body text-slate-800\">\n              <div class=\"mb-2 flex items-start gap-2\">\n                <span aria-hidden=\"true\">–</span>\n                <span data-id=\"pg029_n0010\">A e di si kanë ndryshuar objektet gjatë periudhave historike?</span>\n              </div>\n              <label for=\"item-1\" class=\"sr-only\">A e di si kanë ndryshuar objektet gjatë periudhave historike?</label>\n              <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"A e di si kanë ndryshuar objektet gjatë periudhave historike?\" class=\"w-full min-h-11 rounded-2xl border-2 border-sky-500 bg-white px-4 py-3 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n            </li>\n            <li class=\"adt-body text-slate-800\">\n              <div class=\"mb-2 flex items-start gap-2\">\n                <span aria-hidden=\"true\">–</span>\n                <span data-id=\"pg029_n0012\">Po mjetet e punës, si kanë ndryshuar?</span>\n              </div>\n              <label for=\"item-2\" class=\"sr-only\">Po mjetet e punës, si kanë ndryshuar?</label>\n              <textarea id=\"item-2\" data-activity-item=\"item-2\" aria-label=\"Po mjetet e punës, si kanë ndryshuar?\" class=\"w-full min-h-11 rounded-2xl border-2 border-sky-500 bg-white px-4 py-3 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n            </li>\n            <li class=\"adt-body text-slate-800\">\n              <div class=\"mb-2 flex items-start gap-2\">\n                <span aria-hidden=\"true\">–</span>\n                <span data-id=\"pg029_n0014\">Analizoji fotografitë dhe informacionet e dhëna!</span>\n              </div>\n              <label for=\"item-3\" class=\"sr-only\">Analizoji fotografitë dhe informacionet e dhëna!</label>\n              <textarea id=\"item-3\" data-activity-item=\"item-3\" aria-label=\"Analizoji fotografitë dhe informacionet e dhëna!\" class=\"w-full min-h-11 rounded-2xl border-2 border-sky-500 bg-white px-4 py-3 outline-none focus:border-purple-500 focus:ring-2 focus:ring-purple-200\"></textarea>\n            </li>\n          </ul>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"grid grid-cols-3 gap-2 mb-6 max-sm:grid-cols-1\">\n      <figure class=\"flex flex-col items-center\">\n        <img src=\"images/pg029_im004.png\" alt=\"Katedrale\" data-id=\"pg029_im004\" class=\"w-full h-auto rounded-sm object-cover\">\n        <figcaption class=\"adt-caption italic mt-1 text-slate-800\" data-id=\"pg029_n0017\">Katedrale</figcaption>\n      </figure>\n      <figure class=\"flex flex-col items-center\">\n        <img src=\"images/pg029_im005.png\" alt=\"Xhami\" data-id=\"pg029_im005\" class=\"w-full h-auto rounded-sm object-cover\">\n        <figcaption class=\"adt-caption italic mt-1 text-slate-800\" data-id=\"pg029_n0019\">Xhami</figcaption>\n      </figure>\n      <figure class=\"flex flex-col items-center\">\n        <img src=\"images/pg029_im006.png\" alt=\"Kishë ortodokse\" data-id=\"pg029_im006\" class=\"w-full h-auto rounded-sm object-cover\">\n        <figcaption class=\"adt-caption italic mt-1 text-slate-800\" data-id=\"pg029_n0021\">Kishë ortodokse</figcaption>\n      </figure>\n    </div>\n\n    <p class=\"adt-body leading-relaxed mb-8 text-left text-slate-800\">\n      <span data-id=\"pg029_n0023\">Njerëzit kanë besime dhe bindje të ndryshme, që do të thotë se ekzistojnë edhe fe të ndryshme nëpër botë.</span>\n      <span data-id=\"pg029_n0024\">Shumica e feve kanë edhe objektet e tyre të posaçme për praktikat e besimtarëve që u përkasin atyre feve.</span>\n      <span data-id=\"pg029_n0025\">Edhe këto objekte fetare kanë arkitekturën e tyre të veçantë, e cila, po ashtu, ka ndryshuar përgjatë historisë, por është ruajtur në formën e përgjithshme (shih fotografitë lart).</span>\n    </p>\n\n    <div class=\"mb-8 grid grid-cols-[1.05fr,1.45fr] gap-3 items-start max-lg:grid-cols-1\">\n      <div class=\"grid grid-cols-2 gap-2 max-sm:grid-cols-1\">\n        <img src=\"images/pg029_im007.png\" alt=\"Punishte e vogël me mjete pune të thjeshta\" data-id=\"pg029_im007\" class=\"w-full h-auto object-cover\">\n        <img src=\"images/pg029_im008.png\" alt=\"Fabrikë moderne me shumë punëtorë\" data-id=\"pg029_im008\" class=\"w-full h-auto object-cover\">\n      </div>\n      <p class=\"adt-body leading-relaxed text-left text-slate-800\">\n        <span data-id=\"pg029_n0028\">Zejtarët dikur punonin në punishte të vogla me mjete pune të thjeshta.</span>\n        <span data-id=\"pg029_n0029\">Sot ka fabrika të mëdha moderne, me teknologji bashkëkohore, me numër të madh punëtorësh, që karakterizohen nga cilësia e lartë e prodhimeve.</span>\n      </p>\n    </div>\n\n    <div class=\"mb-8 grid grid-cols-[1.05fr,1.45fr] gap-3 items-start max-lg:grid-cols-1\">\n      <div class=\"grid grid-cols-2 gap-2 max-sm:grid-cols-1\">\n        <img src=\"images/pg029_im009.png\" alt=\"Stallë e thjeshtë me pak kafshë\" data-id=\"pg029_im009\" class=\"w-full h-auto object-cover\">\n        <img src=\"images/pg029_im010.png\" alt=\"Fermë moderne për mbajtjen e kafshëve\" data-id=\"pg029_im010\" class=\"w-full h-auto object-cover\">\n      </div>\n      <p class=\"adt-body leading-relaxed text-left text-slate-800\">\n        <span data-id=\"pg029_n0032\">Blegtoria është mjaft e zhvilluar në vendin tonë.</span>\n        <span data-id=\"pg029_n0033\">Dikur stallat ishin të thjeshta dhe mbaheshin pak kafshë.</span>\n        <span data-id=\"pg029_n0034\">Njerëzit gjithmonë janë marrë me rritjen e kafshëve dhe kanë punuar në kushte të vështira.</span>\n        <span data-id=\"pg029_n0035\">Me zhvillimin e teknologjisë, nga stallat e thjeshta u ndërtuan fermat moderne, të cilat kanë kushte të mira dhe të përshtatshme për mbajtjen e kafshëve.</span>\n      </p>\n    </div>\n\n    <div class=\"grid grid-cols-[1.05fr,1.45fr] gap-3 items-start max-lg:grid-cols-1\">\n      <div class=\"grid grid-cols-2 gap-2 max-sm:grid-cols-1\">\n        <img src=\"images/pg029_im001.png\" alt=\"Punim i tokës me kalë me parmendë\" data-id=\"pg029_im001\" class=\"w-full h-auto object-cover\">\n        <img src=\"images/pg029_im002.png\" alt=\"Bujqësi moderne me traktor në fushë\" data-id=\"pg029_im002\" class=\"w-full h-auto object-cover\">\n      </div>\n      <p class=\"adt-body leading-relaxed text-left text-slate-800\">\n        <span data-id=\"pg029_n0038\">Kosova ka shumë toka pjellore dhe bujqësia ka qenë e zhvilluar në të gjitha kohët.</span>\n        <span data-id=\"pg029_n0039\">Dikur punohej me mjete primitive (me kalë me parmendë, siç shihet në fotografi), ndërsa sot toka punohet me traktorë, kombajna etj.</span>\n        <span data-id=\"pg029_n0040\">Kjo njihet si bujqësi moderne dhe prodhimet janë shumë më të mëdha.</span>\n      </p>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n\n\n\n<script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg030_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg030_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"52\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-c