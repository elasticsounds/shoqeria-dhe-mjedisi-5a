rc=\"./assets/base.bundle.local.js\"></script>\n\n\n\n<script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg007_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg007_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"6\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"mx-auto w-full max-w-5xl bg-white overflow-hidden opacity-0 book\" data-family=\"foreword\">\n  <section data-section-type=\"foreword\" data-section-id=\"pg007_sec001\" class=\"relative px-10 py-14 max-lg:px-8 max-sm:px-5 max-sm:py-8 overflow-hidden bg-white b-page\">\n    <div class=\"relative z-10 max-w-4xl mx-auto\">\n      <h1 class=\"adt-h2 font-bold text-neutral-800 mb-12 max-sm:mb-8 text-left\" data-id=\"pg007_n0002\">Parathënie</h1>\n\n      <p class=\"adt-body text-neutral-800 mb-8 leading-8 text-left\"><span data-id=\"pg007_n0004\">I/e dashur nxënës/e,</span></p>\n\n      <p class=\"adt-body text-neutral-800 mb-6 leading-8 text-left\"><span data-id=\"pg007_n0006\">Ky libër është vazhdimësi e njohurive që ke marrë përgjatë katër vjetëve.</span> <span data-id=\"pg007_n0007\">Tani do të mësosh për jetën e paraardhësve të tu, do të njihesh me monumentet historike, vendbanimet e lashta arkeologjike, kuzhinën dhe veshjet tradicionale kosovare.</span> <span data-id=\"pg007_n0008\">Do të mësosh, gjithashtu, për kulturën, gjuhën, zakonet, traditat dhe llojllojshmërinë etnike e kulturore.</span></p>\n\n      <p class=\"adt-body text-neutral-800 mb-6 leading-8 text-left\"><span data-id=\"pg007_n0010\">Ne e kemi hartuar librin në atë mënyrë që të kesh mundësi të analizosh, të vlerësosh dhe t’i japësh mendimet e tua për zgjidhjen e situatave të ndryshme që kanë të bëjnë me të drejtat e tua dhe me institucionet që kanë për detyrë të të mbrojnë ty.</span> <span data-id=\"pg007_n0011\">Këtë vit do të marrësh informacione edhe për historikun e Republikës së Kosovës, banorët e vjetër të saj, vendet fqinje, bashkëjetesën mes komuniteteve në këtë vend, si dhe për ngjarje të rëndësishme për vendin tonë, si Pavarësia e Kosovës, Beteja e Kosovës dhe Lidhja e Prizrenit.</span> <span data-id=\"pg007_n0012\">Do të njihesh, po ashtu, me Kushtetutën e Kosovës, si ligji themelor i shtetit tonë.</span></p>\n\n      <p class=\"adt-body text-neutral-800 mb-6 leading-8 text-left\"><span data-id=\"pg007_n0014\">Situatat e dhëna dhe ilustrimet do të të ndihmojnë që të kuptosh se si merren vendimet në familje, në shkollë e në shoqëri, pjesë e të cilave duhet të jesh edhe ti.</span> <span data-id=\"pg007_n0015\">Aktivitetet e ndryshme, në të cilat do të marrësh pjesë, do të ngrenë vetëdijen për tolerancë, mirëkuptim dhe bashkëpunim, të cilat janë kushtet themelore për një shoqëri me vlera.</span></p>\n\n      <p class=\"adt-body text-neutral-800 mb-8 leading-8 text-left\"><span data-id=\"pg007_n0017\">Në këtë libër, gjithashtu, jepen edhe informacione të rëndësishme për sëmundjet e ndryshme, kujdesin ndaj pandemisë dhe rëndësinë që ka vaksinimi.</span></p>\n    </div>\n\n    <div class=\"relative z-10 max-w-4xl mx-auto mt-6 space-y-3 max-sm:space-y-4\">\n      <aside class=\"relative pl-10 max-sm:pl-0\">\n        <div class=\"absolute left-0 top-1/2 -translate-y-1/2 w-0 h-0 border-t-[30px] border-b-[30px] border-r-[30px] border-t-transparent border-b-transparent border-r-violet-200 max-sm:hidden\" aria-hidden=\"true\"></div>\n        <div class=\"bg-violet-200 text-neutral-800 px-8 py-5 max-sm:px-5 rounded-sm\">\n          <p class=\"adt-body leading-8 text-left\"><span data-id=\"pg007_n0020\">Libri ka edhe një rubrikë të veçantë - Fjalorthin, që do të të ndihmojë të mësosh fjalë dhe shprehje të reja, duke e pasuruar, kështu, të shprehurit tënd.</span></p>\n        </div>\n      </aside>\n\n      <aside class=\"relative pl-10 max-sm:pl-0\">\n        <div class=\"absolute left-0 top-1/2 -translate-y-1/2 w-0 h-0 border-t-[30px] border-b-[30px] border-r-[30px] border-t-transparent border-b-transparent border-r-amber-300 max-sm:hidden\" aria-hidden=\"true\"></div>\n        <div class=\"bg-amber-300 text-neutral-800 px-8 py-5 max-sm:px-5 rounded-sm\">\n          <p class=\"adt-body leading-8 text-left\"><span data-id=\"pg007_n0023\">Rubrika Provoje veten do të ta krijojë mundësinë që të punosh shumë detyra krijuese dhe do të të ndihmojë për zhvillimin e të menduarit krijues.</span> <span data-id=\"pg007_n0024\">Ato u përkasin niveleve të ndryshme dhe do të ta mundësojnë përdorimin praktik të njohurive.</span></p>\n        </div>\n      </aside>\n\n      <aside class=\"relative pl-10 max-sm:pl-0\">\n        <div class=\"absolute left-0 top-1/2 -translate-y-1/2 w-0 h-0 border-t-[34px] border-b-[34px] border-r-[34px] border-t-transparent border-b-transparent border-r-purple-500/70 max-sm:hidden\" aria-hidden=\"true\"></div>\n        <div class=\"bg-purple-500/70 text-white px-8 py-5 max-sm:px-5 rounded-sm b-foreword-guidance\">\n          <p class=\"adt-body leading-8 text-left\"><span data-id=\"pg007_n0027\">Rubrikat Përdore internetin/Shkathtësi hulumtuese janë lënë që t’i punosh bashkë me prindërit, mësuesin a ndonjë të rritur tjetër, duke pasur parasysh rreziqet që vijnë nga përdorimi i pakontrolluar i teknologjisë informative, veçanërisht internetit.</span> <span data-id=\"pg007_n0028\">Në këtë mënyrë, do të të krijohen shprehi dhe shkathtësi të mira të hulumtimit dhe të kërkimit të informacioneve.</span></p>\n        </div>\n      </aside>\n    </div>\n\n    <div class=\"relative z-10 max-w-4xl mx-auto flex justify-end mt-6 mb-6\">\n      <p class=\"adt-body text-neutral-800 text-left\"><span data-id=\"pg007_n0029\">Autorët</span></p>\n    </div>\n\n    <div class=\"pointer-events-none absolute -left-12 top-[35%] z-0 h-24 w-24 rounded-r-full bg-sky-300/80 max-lg:-left-14 max-lg:top-[41%] max-lg:h-20 max-lg:w-20 max-sm:hidden\" aria-hidden=\"true\"></div>\n\n    <div class=\"relative mt-4 h-[22rem] max-lg:h-[18rem] max-sm:h-[10rem] overflow-hidden\">\n      <div class=\"absolute left-0 bottom-0 w-full h-[72%] bg-sky-300/80 rounded-tl-[8rem] rounded-tr-[16rem] max-sm:rounded-tl-[3rem] max-sm:rounded-tr-[5rem]\" aria-hidden=\"true\"></div>\n      <div class=\"absolute left-0 bottom-0 w-full h-[34%] bg-lime-500/80 rounded-tr-[8rem] max-sm:rounded-tr-[3rem]\" aria-hidden=\"true\"></div>\n      <div class=\"absolute right-[12%] top-[18%] w-48 h-28 bg-white rounded-[50%] rotate-[18deg] max-lg:w-40 max-lg:h-24 max-sm:w-20 max-sm:h-10\" aria-hidden=\"true\"></div>\n      <img data-id=\"pg007_im004\" src=\"images/pg007_im004.png\" alt=\"\" class=\"absolute z-10 right-8 bottom-10 w-36 h-auto max-lg:w-28 max-sm:w-20 max-sm:right-3 max-sm:bottom-4\" role=\"presentation\" aria-hidden=\"true\">\n      <img data-id=\"pg007_im005\" src=\"images/pg007_im005.png\" alt=\"\" class=\"absolute z-10 left-[20%] bottom-10 w-24 h-auto max-lg:w-20 max-sm:w-14 max-sm:left-[18%] max-sm:bottom-3\" role=\"presentation\" aria-hidden=\"true\">\n      <img data-id=\"pg007_im006\" src=\"images/pg007_im006.png\" alt=\"\" class=\"absolute z-10 left-[30%] bottom-8 w-28 h-auto max-lg:w-24 max-sm:w-16 max-sm:left-[30%] max-sm:bottom-2\" role=\"presentation\" aria-hidden=\"true\">\n    </div>\n  </section>\n</div>\n    </main>\n\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n\n\n\n<script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg008_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg008_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"7\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 opacity-0 book\" data-family=\"illustrated-lesson\">\n  <section data-section-type=\"text_and_single_image\" data-section-id=\"pg008_sec001\" class=\"bg-white text-slate-800 pb-10 b-page\">\n    <div class=\"-mx-8 max-sm:-mx-5 bg-purple-500 b-banner\">\n      <div class=\"mx-auto w-full max-w-5xl px-8 max-sm:px-5 py-16 max-sm:py-10\">\n        <h1 class=\"adt-h2 font-bold text-white\" data-id=\"pg008_n0002\">“Jam në klasën e pestë “</h1>\n      </div>\n    </div>\n\n    <aside class=\"mt-0 mb-10 rounded-[2rem] border-4 border-purple-500 bg-white overflow-hidden b-keywords\">\n      <div class=\"flex flex-row max-lg:flex-col items-stretch\">\n        <div class=\"bg-purple-300 px-5 py-4 flex items-center border-r-4 border-purple-500 max-lg:border-r-0 max-lg:border-b-4\">\n          <span class=\"adt-body font-bold text-white b-keyword-label\" data-id=\"pg008_n0004\">Fjalët kyçe:</span>\n        </div>\n        <div class=\"px-5 py-4 flex items-center\">\n          <span class=\"adt-body\" data-id=\"pg008_n0005\">premtim, besim, përgjegjësi, ndryshim, personalitet, përvojë.</span>\n        </div>\n      </div>\n    </aside>\n\n    <div class=\"mb-8 rounded-[1.75rem] bg-sky-300 px-8 py-6 text-center shadow-sm b-panel-thought\">\n      <h3 class=\"adt-h3 font-medium text-slate-800\" data-id=\"pg008_n0007\">Jam në klasën e pestë.</h3>\n      <h3 class=\"adt-h3 font-medium text-slate-800 mt-2\" data-id=\"pg008_n0008\">Çfarë ndryshimesh kam pësuar?</h3>\n    </div>\n\n    <p class=\"adt-body leading-8 mb-8\">\n      <span data-id=\"pg008_n0010\">- Unë jam Ari.</span>\n      <span data-id=\"pg008_n0011\">Jetoj me nënën, babanë dhe motrën.</span>\n      <span data-id=\"pg008_n0012\">Kam një shok të pandashëm.</span>\n      <span data-id=\"pg008_n0013\">Ai është ditari im, të cilit ia tregoj të gjitha gjërat çdo ditë.</span>\n      <span data-id=\"pg008_n0014\">Sapo i tregova që po filloj klasën e pestë.</span>\n    </p>\n\n    <div class=\"clear-both\">\n      <img data-id=\"pg008_im015\" src=\"images/pg008_im015.png\" alt=\"Faqe ditari me tekst të shkruar me dorë në një bllok me spirale të kuqe.\" class=\"w-full h-auto rounded-2xl shadow-md b-diary-photo\">\n      <div class=\"sr-only\">\n        <span data-id=\"pg008_n0016\">I dashur shoku im, Ditar!</span>\n        <span data-id=\"pg008_n0017\">Sot është një ditë shumë e mirë për mua dhe ndihem shumë i gëzuar.</span>\n        <span data-id=\"pg008_n0018\">Unë tani po filloj klasën e pestë!</span>\n        <span data-id=\"pg008_n0019\">I kam blerë tashmë gjërat që më duhen për shkollë dhe u ndjeva mirë kur i shfrytëzova kursimet e mia.</span>\n        <span data-id=\"pg008_n0020\">Ne, po ashtu, tash kemi marrë edhe një mace në familjen tonë, pas shumë lutjesh e kërkesash që unë dhe motra u bëmë prindërve.</span>\n        <span data-id=\"pg008_n0021\">Ata pranuan, sepse më thanë që tani jam më i rritur, , si dhe jam më i përgjegjshëm.</span>\n        <span data-id=\"pg008_n0022\">Dëshira që ta kem një mace më erdhi pasi lexova një lektyrë gjatë pushimeve, në të cilën flitej për një mace shumë të veçantë.</span>\n        <span data-id=\"pg008_n0023\">Mezi pres që këtë t’ua tregoj edhe shokëve e shoqeve në klasë!</span>\n      </div>\n    </div>\n  </section>\n</div>\n    </main>\n\n    <div class=\"relative z-50\" id=\"interface-container\"></div>\n    <div class=\"relative z-50\" id=\"nav-container\"></div>\n    <script src=\"./assets/offline-preloader.js?v=9f3d745a858de581\"></script>\n    <script src=\"./assets/scorm.js\"></script>\n    <script src=\"./assets/base.bundle.local.js\"></script>\n\n\n\n<script src=\"./book-design/responses.js?v=9f3d745a858de581\" data-book-responses=\"true\"></script></body></html>","./pg009_sec001.html":"<!DOCTYPE html>\n<html lang=\"sq\"><head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Shoqëria dhe mjedisi</title>\n    <meta name=\"title-id\" content=\"pg009_sec001\">\n    <!-- Despite the name, this is the page's 1-based position in the reading\n         order, not a section id and not the printed page number. It drives the\n         \"N of M\" dock counter and is re-emitted on every package, so it tracks\n         the current order. Identity lives in title-id above. -->\n    <meta name=\"page-section-id\" content=\"9\">\n    <link href=\"./content/tailwind_output.css\" rel=\"stylesheet\">\n    <link href=\"./assets/libs/fontawesome/css/all.min.css\" rel=\"stylesheet\">\n    <link href=\"./assets/fonts.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"./book-design/components.css?v=9f3d745a858de581\" data-book-style=\"true\"></head>\n\n<body class=\"min-h-screen flex items-center justify-center\">\n    <main class=\"w-full\">\n      <div id=\"content\" class=\"container mx-auto w-full max-w-5xl px-8 max-sm:px-5 opacity-0 book\" data-family=\"illustrated-lesson\">\n  <section data-section-type=\"text_and_images\" data-section-id=\"pg009_sec001\" class=\"bg-white py-8 text-slate-800 max-sm:py-5 b-page\">\n    <aside class=\"mb-8 rounded-[2rem] border-4 border-violet-500 bg-white px-8 py-6 shadow-sm max-sm:px-5 max-sm:py-4\">\n      <div class=\"flex items-start gap-5 max-sm:flex-col max-sm:gap-3\">\n        <img data-id=\"pg009_im005\" src=\"images/pg009_im005.png\" alt=\"Tri pikëpyetje me ngjyra të ndryshme, që simbolizojnë pyetje dhe reflektim.\" class=\"h-20 w-28 shrink-0 object-contain max-sm:h-24 max-sm:w-32\">\n        <div class=\"flex-1 pt-1\">\n          <h1 class=\"adt-h3 mb-3 text-violet-700\" data-id=\"pg009_n0003\">Pyetje për ty</h1>\n          <ul class=\"adt-body list-none space-y-2.5 pl-0 text-slate-800\">\n            <li class=\"flex items-start gap-3\">\n              <span aria-hidden=\"true\" class=\"mt-[0.7em] inline-block h-[2px] w-3 shrink-0 bg-slate-700\"></span>\n              <span data-id=\"pg009_n0006\">Analizo ndryshimet e Arit.</span>\n            </li>\n            <li class=\"flex items-start gap-3\">\n              <span aria-hidden=\"true\" class=\"mt-[0.7em] inline-block h-[2px] w-3 shrink-0 bg-slate-700\"></span>\n              <span data-id=\"pg009_n0008\">Diskuto për ndryshimet e tua me shokët e shoqet.</span>\n            </li>\n            <li class=\"flex items-start gap-3\">\n              <span aria-hidden=\"true\" class=\"mt-[0.7em] inline-block h-[2px] w-3 shrink-0 bg-slate-700\"></span>\n              <span data-id=\"pg009_n0010\">Shkruaj edhe ti në fletën e ditarit për ndryshimet e tua.</span>\n            </li>\n          </ul>\n        </div>\n      </div>\n      <label for=\"item-1\" class=\"sr-only\">Shkruaj edhe ti në fletën e ditarit për ndryshimet e tua.</label>\n      <textarea id=\"item-1\" data-activity-item=\"item-1\" aria-label=\"Shkruaj edhe ti në fletën e ditarit për ndryshimet e tua.\" class=\"mt-5 min-h-11 h-48 w-full rounded-[1.75rem] border-4 border-red-400 bg-white px-4 py-3 adt-body text-slate-800 shadow-inner outline-none focus:ring-4 focus:ring-red-200 max-sm:h-80\" placeholder=\"\"></textarea>\n    </aside>\n\n    <div class=\"border-t-4 border-violet-500 pt-0\">\n      <div class=\"mb-4 flex items-center gap-4 border-l-4 border-violet-500 pl-0 max-sm:items-center max-sm:gap-3 b-panel-reading\">\n        <div class=\"shrink-0 rounded-[1.75rem] bg-violet-400 p-4 shadow-sm\">\n          <img data-id=\"pg009_im006\" src=\"images/pg009_im006.png\" alt=\"Libër i hapur me një lupë sipër, simbol i hulumtimit dhe thellimit të dijes.\" class=\"h-20 w-20 object-contain\">\n        </div>\n        <h2 class=\"adt-h2 text-slate-900\" data-id=\"pg009_n0013\">Thello dijet</h2>\n      </div>\n\n      <p class=\"adt-body mb-4 leading-8 text-left\">\n        <span data-id=\"pg009_n0015\">Njeriu ndryshon vazhdimisht.</span>\n        <span data-id=\"pg009_n0016\">Duke u rritur, ndryshon pamja dhe sjellja e tij.</span>\n        <span data-id=\"pg009_n0017\">Sa më shumë rritet, bëhet më i përgjegjshëm për kryerjen e detyrave, dallon veprimet e mira nga ato jo të mira dhe është në gjendje të marrë vendime të arsyeshme e të argumentuara për situata të ndryshme jetësore.</span>\n      </p>\n\n      <div class=\"float-left mb-5 mr-8 w-[58%] max-lg:float-none max-lg:mr-0 max-lg:w-full\">\n        <div class=\"