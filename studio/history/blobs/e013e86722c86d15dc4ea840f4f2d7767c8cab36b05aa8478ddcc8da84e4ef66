  function storeId(id) { return id === 'pg040_sec002' ? 'pg040_sec001' : id; }
  function save() {
    if (restoring) return;
    var page = current();
    if (!page) return;
    var values = {};
    if (storeId(page.id) === 'pg040_sec001') {
      try { values = JSON.parse(localStorage.getItem(prefix + storeId(page.id)) || '{}') || {}; } catch (_) { values = {}; }
    }
    controls(page.root).forEach(function (el, index) {
      if (['password', 'file'].includes(el.type) || (page.id === 'pg040_sec001' && el.closest('[hidden]'))) return;
      var quizLabel = el.closest('label[role=radio]');
      values[key(el, index)] = el.type === 'radio' || el.type === 'checkbox' ? {checked: quizLabel ? quizLabel.getAttribute('aria-checked') === 'true' : el.checked} : {value: el.value};
    });
    try { localStorage.setItem(prefix + storeId(page.id), JSON.stringify(values)); } catch (_) {}
  }
